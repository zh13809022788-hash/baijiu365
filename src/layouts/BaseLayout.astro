---
import SeoJsonLd from '../components/SeoJsonLd.astro';
import { ADSENSE_CLIENT_ID, SITE_URL } from '../config';

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  type?: 'WebSite' | 'Article' | 'AboutPage';
  canonicalPath?: string;
  noindex?: boolean;
  image?: string;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
  authorUrl?: string;
  jsonLd?: boolean;
  lang?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  keywords,
  type = 'Article',
  canonicalPath,
  noindex = false,
  image,
  datePublished,
  dateModified,
  authorName,
  authorUrl,
  jsonLd = true,
  lang = 'en',
  bodyClass = '',
} = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, SITE_URL).toString();
const socialImage = image ?? new URL('/images/og-cover.jpg', SITE_URL).toString();
const hasAdsenseClientId = ADSENSE_CLIENT_ID.trim() !== '';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Baijiu365 RSS" href="/rss.xml" />
    <meta property="og:site_name" content="Baijiu365" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type === 'WebSite' ? 'website' : 'article'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#120e0a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Inter:wght@400;500;600;700;800&family=Noto+Serif+SC:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {hasAdsenseClientId && <meta name="google-adsense-account" content={ADSENSE_CLIENT_ID} />}
    {hasAdsenseClientId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT_ID}`}
        crossorigin="anonymous"
      ></script>
    )}
    {jsonLd && (
      <SeoJsonLd
        type={type}
        title={title}
        description={description}
        url={canonical}
        image={socialImage}
        datePublished={datePublished}
        dateModified={dateModified}
        authorName={authorName}
        authorUrl={authorUrl}
      />
    )}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" id="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Baijiu365 home">
          <span class="brand-mark" aria-hidden="true" title="酉 (yǒu) — the ancient pictograph of a wine vessel, and the root of 酒 (jiǔ), baijiu">酉</span>
          <span class="brand-text">Baijiu<span class="brand-gold">365</span></span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          <a href="/baijiu-basics/">Learn</a>
          <a href="/types-of-baijiu/">Aroma</a>
          <a href="/how-to-buy-baijiu-outside-china/">Buying</a>
          <a href="/tools/">Tools</a>
          <a href="/db/">Database</a>
          <a href="/jinlingnian-30/" class="nav-house">Our Label</a>
          <a href="/glossary/" class="nav-cta">Glossary</a>
        </nav>
        <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="primary-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a class="brand footer-logo" href="/" aria-label="Baijiu365 home">
            <span class="brand-mark" aria-hidden="true">酉</span>
            <span class="brand-text">Baijiu<span class="brand-gold">365</span></span>
          </a>
          <p>An independent field guide to Chinese baijiu for curious drinkers, hosts, collectors, and bartenders. Style first, bottle second, risk always.</p>
          <p class="footer-note">Independent guide &middot; No paid placements &middot; Practical limits stated</p>
        </div>
        <nav class="footer-col" aria-label="Footer navigation: Learn">
          <h2>Learn</h2>
          <a href="/baijiu-basics/">Baijiu basics</a>
          <a href="/types-of-baijiu/">Aroma types</a>
          <a href="/best-baijiu-for-beginners/">First bottle</a>
          <a href="/how-to-drink-baijiu/">How to drink</a>
          <a href="/baijiu-flavor-wheel/">Flavor wheel</a>
        </nav>
        <nav class="footer-col" aria-label="Footer navigation: Database">
          <h2>Database</h2>
          <a href="/db/">All varieties</a>
          <a href="/db/compare/">Compare bottles</a>
          <a href="/db/aroma/sauce/">Sauce aroma</a>
          <a href="/db/aroma/strong/">Strong aroma</a>
          <a href="/db/region/sichuan/">Sichuan region</a>
        </nav>
        <nav class="footer-col" aria-label="Footer navigation: More">
          <h2>More</h2>
          <a href="/jinlingnian-30/">Jinling Nian 30</a>
          <a href="/tools/">Tools</a>
          <a href="/glossary/">Glossary</a>
          <a href="/about/">About</a>
          <a href="/editorial-policy/">Editorial policy</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <div class="footer-bottom-inner">
          <p>&copy; {new Date().getFullYear()} Baijiu365 &middot; A practical reference for Chinese baijiu.</p>
          <p class="footer-glyph">酉 — the ancient pictograph of a wine vessel, and the root of 酒 (jiǔ). <a href="/about/#the-character-on-our-mark">Why our mark uses it</a>.</p>
          <nav aria-label="Footer navigation: legal">
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="/editorial-policy/">Editorial policy</a>
            <a href="/affiliate-disclosure/">Disclosure</a>
            <a href="/contact/">Contact</a>
          </nav>
        </div>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var header = document.getElementById('site-header');
        var toggle = document.getElementById('nav-toggle');
        var onScroll = function () {
          if (window.scrollY > 24) header.classList.add('scrolled');
          else header.classList.remove('scrolled');
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        if (toggle) {
          toggle.addEventListener('click', function () {
            var open = header.classList.toggle('nav-open');
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
        }
        document.querySelectorAll('video[data-autoplay]').forEach(function (v) {
          v.play().catch(function () { v.classList.add('video-fallback'); });
        });
        var revealEls = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
            });
          }, { threshold: 0, rootMargin: '0px 0px -6% 0px' });
          revealEls.forEach(function (el) { io.observe(el); });
        } else {
          revealEls.forEach(function (el) { el.classList.add('in'); });
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Ink & gold palette */
    --ink-950: #0d0a07;
    --ink-900: #120e0a;
    --ink-850: #17120d;
    --ink-800: #1c1610;
    --ink-700: #251d15;
    --ink-600: #322619;
    --gold-300: #e8cf9a;
    --gold-400: #d3ac68;
    --gold-500: #b98f3f;
    --gold-600: #96702c;
    --red: #b03a2a;
    --red-deep: #7e2418;
    --paper: #f6f1e6;
    --paper-2: #efe7d4;
    --panel: #fffdf7;
    --text-on-dark: #f2ecdd;
    --muted-on-dark: rgba(242, 236, 221, 0.68);
    --text-ink: #221a11;
    --muted: #6f6350;
    --line: #ded3ba;
    --line-dark: rgba(211, 172, 104, 0.18);
    --line-dark-strong: rgba(211, 172, 104, 0.38);
    --shadow-dark: 0 18px 50px rgba(0, 0, 0, 0.45);
    --serif: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    --serif-cn: "Noto Serif SC", "Songti SC", "SimSun", serif;
    --sans: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;

    /* Legacy aliases (older page styles) mapped to the dark-gold system */
    --ink: #f2ecdd;
    --muted: rgba(242, 236, 221, 0.68);
    --soft: rgba(242, 236, 221, 0.5);
    --line: rgba(211, 172, 104, 0.22);
    --paper: #f6f1e6;
    --panel: #1c1610;
    --panel-warm: #251d15;
    --red: #b03a2a;
    --red-deep: #7e2418;
    --gold: #d3ac68;
    --green: #8fb37e;
    --blue: #9fc0cf;
    --shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    font-family: var(--sans);
    background: var(--ink-900);
    color: var(--text-on-dark);
    font-size: 16px;
    line-height: 1.62;
    -webkit-font-smoothing: antialiased;
  }

  a { color: inherit; }
  img, video { max-width: 100%; display: block; }

  ::selection { background: rgba(185, 143, 63, 0.35); color: #fff; }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 200;
    padding: 10px 16px;
    background: var(--gold-400);
    color: var(--ink-900);
    font-weight: 700;
  }
  .skip-link:focus { left: 12px; top: 12px; }

  main { min-height: 72vh; }

  /* ---------- Header ---------- */
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    transition: background 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
    border-bottom: 1px solid transparent;
  }

  .header-inner {
    width: min(1220px, 100%);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px clamp(18px, 4vw, 44px);
  }

  .site-header.scrolled {
    background: rgba(13, 10, 7, 0.92);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--line-dark);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-on-dark);
    white-space: nowrap;
  }

  .brand-mark {
    display: inline-flex;
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-dark-strong);
    border-radius: 8px;
    background: linear-gradient(160deg, rgba(211, 172, 104, 0.22), rgba(211, 172, 104, 0.05));
    color: var(--gold-300);
    font-family: var(--serif-cn);
    font-size: 20px;
    font-weight: 700;
  }

  .brand-text {
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .brand-gold { color: var(--gold-400); }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .primary-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 6px 12px;
    border-radius: 6px;
    color: rgba(242, 236, 221, 0.82);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: color 0.25s ease, background 0.25s ease;
  }

  .primary-nav a::after {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 2px;
    height: 1px;
    background: var(--gold-400);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .primary-nav a:hover {
    color: var(--gold-300);
    background: rgba(211, 172, 104, 0.08);
  }
  .primary-nav a:hover::after { transform: scaleX(1); }

  .primary-nav .nav-cta {
    margin-left: 6px;
    border: 1px solid var(--line-dark-strong);
    color: var(--gold-300);
  }
  .primary-nav .nav-cta:hover {
    background: rgba(211, 172, 104, 0.14);
  }
  .primary-nav .nav-cta::after { display: none; }

  .primary-nav .nav-house {
    color: var(--gold-300);
    font-weight: 600;
  }
  .primary-nav .nav-house::before {
    content: "";
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--gold-500);
    box-shadow: 0 0 8px rgba(211, 172, 104, 0.8);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 10px 9px;
    border: 1px solid var(--line-dark-strong);
    border-radius: 8px;
    background: rgba(13, 10, 7, 0.6);
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    height: 2px;
    background: var(--gold-300);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  /* ---------- Typography & utilities ---------- */
  h1, h2, h3, h4 {
    font-family: var(--serif);
    line-height: 1.12;
    letter-spacing: 0.005em;
    color: var(--text-on-dark);
  }

  h1 { margin: 0; font-size: clamp(34px, 4.6vw, 58px); font-weight: 600; }
  h2 { margin: 0 0 14px; font-size: clamp(26px, 3.2vw, 38px); font-weight: 600; }
  h3 { margin: 0 0 8px; font-size: 19px; font-weight: 600; }

  .wrap { width: min(1220px, 100%); margin: 0 auto; padding-left: clamp(18px, 4vw, 44px); padding-right: clamp(18px, 4vw, 44px); }
  .narrow { width: min(780px, 100%); margin: 0 auto; }

  .section { padding: clamp(48px, 6.5vw, 96px) 0; position: relative; }
  .section.tight { padding-top: clamp(28px, 3vw, 44px); }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--gold-400);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .eyebrow a { color: inherit; text-decoration: none; }
  .eyebrow a:hover { color: var(--gold-300); }

  .lede {
    max-width: 720px;
    margin: 16px 0 0;
    color: var(--muted-on-dark);
    font-size: clamp(16px, 1.3vw, 18.5px);
    line-height: 1.55;
  }

  .cn-serif { font-family: var(--serif-cn); }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    padding: 12px 22px;
    border: 1px solid var(--line-dark-strong);
    border-radius: 6px;
    background: transparent;
    color: var(--text-on-dark);
    font-size: 14.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: all 0.28s ease;
  }
  .button:hover {
    border-color: var(--gold-400);
    color: var(--gold-300);
    background: rgba(211, 172, 104, 0.1);
    transform: translateY(-1px);
  }
  .button.primary, .button:not(.secondary) {
    background: linear-gradient(160deg, var(--gold-400), var(--gold-600));
    border-color: transparent;
    color: var(--ink-900);
  }
  .button.primary:hover, .button:not(.secondary):hover {
    color: var(--ink-900);
    background: linear-gradient(160deg, var(--gold-300), var(--gold-500));
    box-shadow: 0 10px 26px rgba(185, 143, 63, 0.3);
  }
  .button.secondary {
    background: transparent;
    color: var(--text-on-dark);
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 22px;
    margin-bottom: clamp(24px, 3vw, 40px);
  }
  .section-heading h2, .section-heading p { margin: 0; }
  .section-heading p { max-width: 500px; color: var(--muted-on-dark); font-size: 15px; }

  .js .reveal { opacity: 0; transform: translateY(22px); transition: opacity 0.8s ease, transform 0.8s ease; }
  .js .reveal.in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .js .reveal { opacity: 1; transform: none; transition: none; }
  }

  /* ---------- Cards & grids ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .card {
    padding: 24px;
    border: 1px solid var(--line-dark);
    border-radius: 10px;
    background: linear-gradient(170deg, rgba(255, 253, 247, 0.045), rgba(255, 253, 247, 0.015));
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }
  .card:hover {
    border-color: var(--line-dark-strong);
    transform: translateY(-3px);
    box-shadow: var(--shadow-dark);
  }

  .card-kicker {
    margin-bottom: 12px;
    color: var(--gold-400);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .card h3 { margin: 0 0 8px; }
  .card p { margin: 0 0 12px; color: var(--muted-on-dark); font-size: 14.5px; }

  .card a, .next-links a, .feature-list a, .pathway a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--gold-300);
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
  }
  .card a:hover, .next-links a:hover, .feature-list a:hover, .pathway a:hover { color: var(--gold-400); }

  .profile-list { display: grid; gap: 16px; }
  .profile-card {
    padding: 24px;
    border: 1px solid var(--line-dark);
    border-radius: 10px;
    background: linear-gradient(170deg, rgba(255, 253, 247, 0.045), rgba(255, 253, 247, 0.015));
  }
  .profile-card h2 { margin-top: 0; font-size: 26px; }
  .profile-card p { color: var(--muted-on-dark); }

  .pathway, .next-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 18px;
  }

  .pathway a, .next-links a, .feature-list a {
    display: flex;
    padding: 14px 16px;
    border: 1px solid var(--line-dark);
    border-radius: 8px;
    background: rgba(255, 253, 247, 0.03);
    color: var(--text-on-dark);
    font-size: 14.5px;
    font-weight: 700;
    transition: border-color 0.3s ease, color 0.3s ease;
  }
  .pathway a:hover, .next-links a:hover, .feature-list a:hover {
    border-color: var(--gold-500);
    color: var(--gold-300);
  }

  .feature-list { display: grid; gap: 10px; }

  /* ---------- Article & content ---------- */
  .article-header {
    position: relative;
    padding: clamp(120px, 15vh, 170px) 0 clamp(36px, 4vw, 56px);
    background:
      radial-gradient(1200px 500px at 18% -10%, rgba(185, 143, 63, 0.16), transparent 60%),
      linear-gradient(180deg, var(--ink-850), var(--ink-900));
    border-bottom: 1px solid var(--line-dark);
    overflow: hidden;
  }
  .article-header::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--line-dark-strong), transparent);
  }
  .article-header h1 { max-width: 840px; }
  .article-header .lede { color: var(--muted-on-dark); }

  .content { padding: clamp(36px, 5vw, 64px) 0 80px; background: var(--ink-900); }
  .content article { width: min(780px, 100%); margin: 0 auto; }
  .content article h2 { margin-top: 44px; font-size: 27px; }
  .content article h2:first-child { margin-top: 0; }
  .content article h3 { margin-top: 30px; }
  .content article p { margin: 0 0 18px; color: rgba(242, 236, 221, 0.82); font-size: 16.5px; line-height: 1.72; }
  .content article ul, .content article ol { margin: 0 0 20px; padding-left: 22px; }
  .content article li { margin-bottom: 9px; color: rgba(242, 236, 221, 0.78); }
  .content article a { color: var(--gold-300); text-decoration: underline; text-decoration-color: rgba(211, 172, 104, 0.4); text-underline-offset: 3px; }
  .content article a:hover { color: var(--gold-400); }
  .content article strong { color: var(--text-on-dark); }

  /* ---------- Long-form article furniture ---------- */
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 26px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--line-dark);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-on-dark);
  }
  .article-meta span { display: inline-flex; align-items: baseline; gap: 8px; }
  .article-meta b { color: var(--gold-300); font-weight: 600; letter-spacing: 0.06em; }

  .toc {
    margin: 0 0 38px;
    padding: 22px 24px 24px;
    border: 1px solid var(--line-dark);
    border-radius: 12px;
    background: linear-gradient(170deg, rgba(211, 172, 104, 0.07), rgba(211, 172, 104, 0.02));
  }
  .content .toc h2 {
    margin: 0 0 14px;
    font-family: var(--sans);
    font-size: 11.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-300);
  }
  .toc ol {
    counter-reset: toc;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc li { counter-increment: toc; margin: 0; }
  .toc li a {
    display: block;
    padding: 6px 0 6px 26px;
    position: relative;
    font-size: 14px;
    color: rgba(242, 236, 221, 0.8);
    text-decoration: none;
    border-bottom: 1px dotted rgba(211, 172, 104, 0.16);
  }
  .toc li a::before {
    content: counter(toc, decimal-leading-zero);
    position: absolute;
    left: 0;
    color: var(--gold-500);
    font-size: 11px;
    letter-spacing: 0.08em;
    top: 8px;
  }
  .toc li a:hover { color: var(--gold-300); }

  .key-points {
    margin: 0 0 34px;
    padding: 22px 24px;
    border: 1px solid var(--line-dark-strong);
    border-radius: 12px;
    background: rgba(255, 253, 247, 0.03);
  }
  .content .key-points h2 {
    margin: 0 0 12px;
    font-family: var(--sans);
    font-size: 11.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-300);
  }
  .key-points ul { margin: 0; padding-left: 0; list-style: none; }
  .key-points li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 9px;
    font-size: 15px;
    color: rgba(242, 236, 221, 0.84);
  }
  .key-points li:last-child { margin-bottom: 0; }
  .key-points li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 9px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold-500);
  }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 26px 0;
    background: var(--line-dark);
    border: 1px solid var(--line-dark);
    border-radius: 10px;
    overflow: hidden;
  }
  .stat-row div { padding: 16px 16px 15px; background: var(--ink-850); }
  .stat-row strong {
    display: block;
    font-family: var(--serif);
    font-size: 26px;
    line-height: 1.1;
    color: var(--gold-300);
    letter-spacing: 0.01em;
  }
  .stat-row span {
    display: block;
    margin-top: 5px;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-on-dark);
  }

  .content article figure { margin: 28px 0; }
  .content article figure img {
    width: 100%;
    border-radius: 10px;
    border: 1px solid var(--line-dark);
  }
  .content article figcaption {
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--muted-on-dark);
    letter-spacing: 0.02em;
  }
  .content article blockquote {
    margin: 26px 0;
    padding: 4px 0 4px 22px;
    border-left: 2px solid var(--gold-500);
    font-family: var(--serif);
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-on-dark);
  }
  .content article blockquote p { margin: 0; font-size: inherit; color: inherit; }

  .source-list {
    margin: 34px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line-dark);
    font-size: 13px;
    color: var(--muted-on-dark);
  }
  .content .source-list h2 {
    margin: 0 0 10px;
    font-family: var(--sans);
    font-size: 11.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-300);
  }
  .source-list ol { margin: 0; padding-left: 20px; }
  .source-list li { margin-bottom: 6px; font-size: 13px; }

  .callout, .decision-box {
    margin: 24px 0;
    padding: 20px 22px;
    border: 1px solid var(--line-dark);
    border-left: 3px solid var(--gold-500);
    border-radius: 0 10px 10px 0;
    background: linear-gradient(170deg, rgba(211, 172, 104, 0.09), rgba(211, 172, 104, 0.03));
  }
  .callout p, .decision-box p { margin: 0; color: rgba(242, 236, 221, 0.85); }
  .callout.warning { border-left-color: var(--red); }

  .feature-band, .split, .database-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(280px, 1fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
    padding: clamp(24px, 3vw, 40px) 0;
    border-top: 1px solid var(--line-dark);
    border-bottom: 1px solid var(--line-dark);
  }
  .split p { color: var(--muted-on-dark); font-size: 15.5px; }

  /* ---------- Tables ---------- */
  .table-wrap {
    margin: 20px 0;
    overflow-x: auto;
    border: 1px solid var(--line-dark);
    border-radius: 10px;
    background: rgba(255, 253, 247, 0.02);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 620px;
    font-size: 14.5px;
  }

  th, td {
    padding: 13px 16px;
    border-bottom: 1px solid var(--line-dark);
    text-align: left;
    vertical-align: top;
  }
  th {
    color: var(--gold-300);
    background: rgba(211, 172, 104, 0.08);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  td { color: rgba(242, 236, 221, 0.82); }
  td a { color: var(--gold-300); text-decoration: none; }
  td a:hover { text-decoration: underline; }
  tr:last-child td { border-bottom: 0; }

  /* ---------- Dark database panel ---------- */
  .database-panel {
    padding: 28px;
    border: 1px solid var(--line-dark-strong);
    border-radius: 12px;
    background:
      radial-gradient(800px 300px at 85% 0%, rgba(185, 143, 63, 0.14), transparent 60%),
      linear-gradient(170deg, var(--ink-800), var(--ink-950));
    box-shadow: var(--shadow-dark);
  }
  .database-panel p { color: var(--muted-on-dark); }
  .database-panel .eyebrow { color: var(--gold-400); }

  .database-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--line-dark);
    border-radius: 10px;
    overflow: hidden;
    background: var(--line-dark);
  }
  .database-metrics a, .database-metrics span {
    min-height: 96px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px;
    background: rgba(18, 14, 10, 0.92);
    text-decoration: none;
    transition: background 0.3s ease;
  }
  .database-metrics a:hover { background: rgba(211, 172, 104, 0.1); }
  .database-metrics strong { font-family: var(--serif); font-size: 30px; line-height: 1; color: var(--gold-300); }
  .database-metrics small { color: var(--muted-on-dark); font-size: 12.5px; }

  .trust-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    padding: 18px 0;
    border-top: 1px solid var(--line-dark);
    color: var(--muted-on-dark);
    font-size: 13.5px;
  }
  .trust-strip span, .trust-strip a {
    padding: 7px 12px;
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    background: rgba(255, 253, 247, 0.03);
    text-decoration: none;
    color: var(--text-on-dark);
    transition: border-color 0.3s ease;
  }
  .trust-strip a:hover { border-color: var(--gold-500); color: var(--gold-300); }

  .faq { margin-top: 40px; padding-top: 12px; border-top: 1px solid var(--line-dark); }
  .faq h2 { margin-top: 0; }
  .faq h3 { margin-top: 24px; color: var(--gold-300); }

  /* ---------- Footer ---------- */
  .site-footer {
    background: var(--ink-950);
    border-top: 1px solid var(--line-dark);
    color: var(--muted-on-dark);
    font-size: 14px;
  }

  .footer-inner {
    width: min(1220px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(280px, 1.2fr) repeat(3, minmax(140px, 0.85fr));
    gap: clamp(28px, 4vw, 56px);
    padding: clamp(48px, 6vw, 80px) clamp(18px, 4vw, 44px) 40px;
  }

  .footer-brand p { margin: 18px 0 0; max-width: 340px; line-height: 1.7; }
  .footer-note { color: rgba(242, 236, 221, 0.45); font-size: 13px; }

  .footer-logo { margin-bottom: 4px; }

  .footer-col { display: grid; align-content: start; gap: 10px; }
  .footer-col h2 {
    margin: 0 0 6px;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-400);
  }
  .footer-col a {
    color: var(--muted-on-dark);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.25s ease;
    width: fit-content;
  }
  .footer-col a:hover { color: var(--gold-300); }

  .footer-bottom { border-top: 1px solid var(--line-dark); }
  .footer-bottom-inner {
    width: min(1220px, 100%);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 22px clamp(18px, 4vw, 44px);
    font-size: 13px;
    color: rgba(242, 236, 221, 0.5);
  }
  .footer-bottom p { margin: 0; }
  .footer-bottom .footer-glyph {
    flex: 1 0 100%;
    order: 3;
    margin-top: 2px;
    font-size: 12px;
    line-height: 1.6;
    color: rgba(242, 236, 221, 0.38);
  }
  .footer-bottom .footer-glyph a { color: rgba(211, 172, 104, 0.6); text-decoration: none; border-bottom: 1px dotted rgba(211, 172, 104, 0.3); }
  .footer-bottom .footer-glyph a:hover { color: var(--gold-300); }
  .footer-bottom nav { display: flex; flex-wrap: wrap; gap: 18px; }
  .footer-bottom nav a { color: rgba(242, 236, 221, 0.5); text-decoration: none; }
  .footer-bottom nav a:hover { color: var(--gold-300); }

  /* ---------- Hero (video) ---------- */
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: flex-end;
    padding: clamp(120px, 18vh, 200px) 0 clamp(40px, 6vh, 72px);
    overflow: hidden;
    background: var(--ink-950);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-media video, .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(13, 10, 7, 0.55) 0%, rgba(13, 10, 7, 0.25) 40%, rgba(13, 10, 7, 0.92) 100%),
      linear-gradient(90deg, rgba(13, 10, 7, 0.72) 0%, rgba(13, 10, 7, 0.1) 60%);
  }
  .hero-media video.video-fallback { display: none; }

  .hero-content { position: relative; z-index: 1; width: min(1220px, 100%); margin: 0 auto; padding: 0 clamp(18px, 4vw, 44px); }

  .hero-title { max-width: 780px; font-size: clamp(40px, 6vw, 74px); font-weight: 600; line-height: 1.05; }
  .hero-title em { font-style: italic; color: var(--gold-300); }
  .hero-title .cn { font-family: var(--serif-cn); font-style: normal; color: var(--gold-400); }

  .hero .lede { max-width: 640px; font-size: clamp(16.5px, 1.5vw, 19px); }

  .hero-stats {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 4vw, 48px);
    margin-top: clamp(28px, 4vh, 44px);
    padding-top: 22px;
    border-top: 1px solid var(--line-dark);
  }
  .hero-stats div { display: grid; gap: 2px; }
  .hero-stats strong { font-family: var(--serif); font-size: clamp(22px, 2.4vw, 30px); font-weight: 600; color: var(--gold-300); line-height: 1; }
  .hero-stats span { font-size: 12.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-on-dark); }

  /* ---------- Aroma cards ---------- */
  .aroma-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .aroma-card {
    position: relative;
    display: block;
    min-height: 300px;
    border: 1px solid var(--line-dark);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    background: var(--ink-800);
  }
  .aroma-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .aroma-card:hover img { transform: scale(1.06); }
  .aroma-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(13, 10, 7, 0.15) 0%, rgba(13, 10, 7, 0.88) 82%);
    transition: opacity 0.4s ease;
  }
  .aroma-card:hover::after { opacity: 0.85; }
  .aroma-card-body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    padding: 20px 22px;
  }
  .aroma-card-body .kicker {
    margin: 0 0 4px;
    color: var(--gold-300);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .aroma-card-body h3 { margin: 0 0 4px; font-size: 22px; }
  .aroma-card-body p { margin: 0; color: var(--muted-on-dark); font-size: 13.5px; }

  /* ---------- Craft split with video ---------- */
  .craft-split {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .craft-media {
    position: relative;
    border: 1px solid var(--line-dark-strong);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow-dark);
    aspect-ratio: 16 / 10;
    background: var(--ink-800);
  }
  .craft-media video, .craft-media img { width: 100%; height: 100%; object-fit: cover; }
  .craft-media video.video-fallback { display: none; }

  .process-steps { display: grid; gap: 14px; margin-top: 28px; }
  .process-steps li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 16px;
    align-items: start;
    list-style: none;
  }
  .process-steps { padding: 0; margin-left: 0; }
  .step-num {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-dark-strong);
    border-radius: 50%;
    color: var(--gold-300);
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 600;
  }
  .process-steps strong { display: block; font-size: 15.5px; color: var(--text-on-dark); }
  .process-steps p { margin: 2px 0 0; color: var(--muted-on-dark); font-size: 14px; }

  /* ---------- Guide media cards ---------- */
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .guide-card-media {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line-dark);
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(170deg, rgba(255, 253, 247, 0.045), rgba(255, 253, 247, 0.015));
    text-decoration: none;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }
  .guide-card-media:hover {
    border-color: var(--line-dark-strong);
    transform: translateY(-4px);
    box-shadow: var(--shadow-dark);
  }
  .guide-card-media .thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--ink-800);
  }
  .guide-card-media .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .guide-card-media:hover .thumb img { transform: scale(1.07); }
  .guide-card-media .thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(13, 10, 7, 0.55));
  }
  .guide-card-media .body { padding: 20px 22px 24px; display: grid; gap: 8px; }
  .guide-card-media .kicker {
    margin: 0;
    color: var(--gold-400);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .guide-card-media h3 { margin: 0; font-size: 20px; }
  .guide-card-media p { margin: 0; color: var(--muted-on-dark); font-size: 14px; }
  .guide-card-media .more {
    color: var(--gold-300);
    font-size: 13px;
    font-weight: 700;
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }

  /* ---------- Variety bottle cards ---------- */
  .variety-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .variety-card {
    position: relative;
    display: block;
    border: 1px solid var(--line-dark);
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(180deg, var(--ink-800), var(--ink-950));
    text-decoration: none;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }
  .variety-card:hover {
    border-color: var(--gold-600);
    transform: translateY(-4px);
    box-shadow: var(--shadow-dark);
  }
  .variety-card .bottle {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: radial-gradient(120% 80% at 50% 20%, rgba(211, 172, 104, 0.12), transparent 60%), var(--ink-900);
  }
  .variety-card .bottle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .variety-card:hover .bottle img { transform: scale(1.05); }
  .variety-card .body { padding: 14px 16px 18px; }
  .variety-card h3 { margin: 0 0 2px; font-size: 17.5px; }
  .variety-card .cn { color: var(--gold-400); font-family: var(--serif-cn); font-size: 14px; }
  .variety-card .meta { margin: 6px 0 0; color: var(--muted-on-dark); font-size: 12.5px; }

  /* ---------- Full-bleed quote band ---------- */
  .quote-band {
    position: relative;
    padding: clamp(72px, 10vw, 130px) 0;
    overflow: hidden;
    background: var(--ink-950);
  }
  .quote-band .bg {
    position: absolute;
    inset: 0;
  }
  .quote-band .bg img { width: 100%; height: 100%; object-fit: cover; opacity: 0.5; }
  .quote-band::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--ink-900), rgba(13, 10, 7, 0.55) 50%, var(--ink-900));
  }
  .quote-band .wrap { position: relative; z-index: 1; }
  .quote-band blockquote {
    margin: 0;
    max-width: 880px;
    font-family: var(--serif);
    font-size: clamp(26px, 3.4vw, 44px);
    font-weight: 500;
    font-style: italic;
    line-height: 1.25;
    color: var(--text-on-dark);
  }
  .quote-band blockquote .cn { font-family: var(--serif-cn); font-style: normal; color: var(--gold-300); }
  .quote-band cite {
    display: block;
    margin-top: 22px;
    color: var(--gold-400);
    font-style: normal;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* ---------- Tools strip ---------- */
  .tools-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .tool-tile {
    display: grid;
    gap: 8px;
    padding: 26px 22px;
    border: 1px solid var(--line-dark);
    border-radius: 12px;
    background: linear-gradient(170deg, rgba(211, 172, 104, 0.07), rgba(211, 172, 104, 0.02));
    text-decoration: none;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .tool-tile:hover { border-color: var(--gold-600); transform: translateY(-3px); }
  .tool-tile .num { font-family: var(--serif); font-size: 15px; color: var(--gold-400); }
  .tool-tile strong { font-family: var(--serif); font-size: 20px; font-weight: 600; }
  .tool-tile span { color: var(--muted-on-dark); font-size: 13.5px; }

  /* ---------- CTA band ---------- */
  .cta-band {
    position: relative;
    padding: clamp(56px, 7vw, 100px) 0;
    background:
      radial-gradient(900px 400px at 80% 20%, rgba(185, 143, 63, 0.18), transparent 60%),
      linear-gradient(180deg, var(--ink-900), var(--ink-950));
    border-top: 1px solid var(--line-dark);
    text-align: center;
  }
  .cta-band h2 { max-width: 720px; margin: 0 auto; }
  .cta-band p { max-width: 560px; margin: 16px auto 0; color: var(--muted-on-dark); }
  .cta-band .actions { justify-content: center; }

  /* ---------- House bottle band ---------- */
  .house-band {
    position: relative;
    padding: clamp(56px, 7vw, 104px) 0;
    background:
      radial-gradient(760px 420px at 18% 30%, rgba(185, 143, 63, 0.16), transparent 62%),
      linear-gradient(180deg, var(--ink-950), #14100b);
    border-top: 1px solid var(--line-dark);
    border-bottom: 1px solid var(--line-dark);
    overflow: hidden;
  }
  .house-split {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(28px, 4.5vw, 72px);
