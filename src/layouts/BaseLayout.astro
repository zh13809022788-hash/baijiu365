---
import SeoJsonLd from '../components/SeoJsonLd.astro';
import { ADSENSE_CLIENT_ID, SITE_URL } from '../config';

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  type?: 'WebSite' | 'Article' | 'AboutPage';
  canonicalPath?: string;
  noindex?: boolean;
  image?: string;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
  authorUrl?: string;
  jsonLd?: boolean;
  lang?: string;
}

const {
  title,
  description,
  keywords,
  type = 'Article',
  canonicalPath,
  noindex = false,
  image,
  datePublished,
  dateModified,
  authorName,
  authorUrl,
  jsonLd = true,
  lang = 'en',
} = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, SITE_URL).toString();
const socialImage = image ?? new URL('/images/baijiu-field-guide.png', SITE_URL).toString();
const hasAdsenseClientId = ADSENSE_CLIENT_ID.trim() !== '';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Baijiu365 RSS" href="/rss.xml" />
    <meta property="og:site_name" content="Baijiu365" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type === 'WebSite' ? 'website' : 'article'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary" />
    {hasAdsenseClientId && <meta name="google-adsense-account" content={ADSENSE_CLIENT_ID} />}
    {hasAdsenseClientId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT_ID}`}
        crossorigin="anonymous"
      ></script>
    )}
    {jsonLd && (
      <SeoJsonLd
        type={type}
        title={title}
        description={description}
        url={canonical}
        image={socialImage}
        datePublished={datePublished}
        dateModified={dateModified}
        authorName={authorName}
        authorUrl={authorUrl}
      />
    )}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Baijiu365 home">
        <span class="brand-mark">B365</span>
        <span>Baijiu365</span>
      </a>
      <nav class="primary-nav" aria-label="Primary navigation">
        <a href="/baijiu-basics/">Learn</a>
        <a href="/types-of-baijiu/">Aroma</a>
        <a href="/how-to-buy-baijiu-outside-china/">Buying</a>
        <a href="/tools/">Tools</a>
        <a href="/db/">Database</a>
        <a href="/glossary/" class="nav-cta">Glossary</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>Baijiu365 is an independent field guide to Chinese baijiu for curious drinkers, hosts, collectors, and bartenders.</p>
        <nav aria-label="Footer navigation">
          <a href="/baijiu-basics/">Basics</a>
          <a href="/types-of-baijiu/">Aroma types</a>
          <a href="/best-baijiu-for-beginners/">Beginner buying</a>
          <a href="/tools/">Tools</a>
          <a href="/glossary/">Glossary</a>
          <a href="/editorial-policy/">Editorial policy</a>
          <a href="/affiliate-disclosure/">Affiliate disclosure</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #1b1713;
    --muted: #665d54;
    --soft: #8a8075;
    --line: #ded6ca;
    --paper: #faf7f1;
    --panel: #fffdf8;
    --panel-warm: #f6efe4;
    --red: #9f2f24;
    --red-deep: #6f231c;
    --gold: #ae7c32;
    --green: #4f6848;
    --blue: #355f72;
    --shadow: 0 8px 22px rgba(28, 20, 14, 0.08);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--ink);
    background: var(--paper);
    font-size: 15px;
    line-height: 1.58;
  }

  a { color: inherit; }
  img { max-width: 100%; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 22px;
    padding: 10px clamp(18px, 4vw, 44px);
    border-bottom: 1px solid var(--line);
    background: rgba(250, 247, 241, 0.96);
    backdrop-filter: blur(12px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 20px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-mark {
    display: inline-flex;
    height: 30px;
    align-items: center;
    justify-content: center;
    padding: 0 8px;
    border: 1px solid rgba(159, 47, 36, 0.24);
    border-radius: 5px;
    background: #fffdf8;
    color: var(--red);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 900;
  }

  .primary-nav,
  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px 12px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
  }

  .primary-nav a,
  .site-footer nav a {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 5px 7px;
    border-radius: 5px;
    text-decoration: none;
  }

  .primary-nav a:hover,
  .site-footer nav a:hover {
    color: var(--red);
    background: rgba(159, 47, 36, 0.06);
  }

  .primary-nav .nav-cta {
    color: var(--red);
  }

  main { min-height: 70vh; }

  .section {
    padding: clamp(34px, 5vw, 58px) clamp(18px, 4vw, 44px);
  }

  .section.tight { padding-top: 18px; }

  .wrap {
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .narrow {
    width: min(740px, 100%);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--red);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1, h2, h3 {
    font-family: Georgia, "Times New Roman", serif;
    line-height: 1.14;
    letter-spacing: 0;
  }

  h1 {
    margin: 0;
    max-width: 820px;
    font-size: clamp(30px, 4vw, 46px);
  }

  h2 {
    margin: 0 0 12px;
    font-size: clamp(22px, 2.4vw, 30px);
  }

  h3 {
    margin: 0 0 7px;
    font-size: 18px;
  }

  .lede {
    max-width: 700px;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: clamp(15px, 1.25vw, 17px);
    line-height: 1.48;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 18px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 8px 13px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: #fffdf8;
    color: var(--ink);
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
  }

  .button.secondary {
    background: transparent;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .card {
    min-height: auto;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--panel);
    box-shadow: none;
  }

  .card:hover {
    border-color: rgba(159, 47, 36, 0.34);
    box-shadow: var(--shadow);
  }

  .card-kicker {
    margin-bottom: 10px;
    color: var(--soft);
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .card p, .narrow p, li { color: var(--muted); }

  .card p {
    margin: 0 0 10px;
    font-size: 14px;
  }

  .card a {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    color: var(--red);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }

  .profile-list { display: grid; gap: 14px; }

  .profile-card {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fff;
  }

  .profile-card h2 { margin-top: 0; font-size: 24px; }

  .pathway,
  .next-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 16px;
  }

  .pathway a,
  .next-links a,
  .feature-list a {
    display: block;
    padding: 13px 14px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fffdf8;
    color: var(--ink);
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
  }

  .pathway a:hover,
  .next-links a:hover,
  .feature-list a:hover {
    border-color: rgba(159, 47, 36, 0.42);
    color: var(--red);
  }

  .article-header {
    padding: clamp(34px, 5vw, 58px) clamp(18px, 4vw, 44px) 22px;
    border-bottom: 1px solid var(--line);
    background: #f4ead9;
  }

  .article-header h1 {
    max-width: 820px;
    color: var(--ink);
    font-size: clamp(28px, 3.8vw, 42px);
  }

  .article-header .lede { color: var(--muted); }

  .content {
    padding: 30px clamp(18px, 4vw, 44px) 60px;
  }

  .content article {
    width: min(740px, 100%);
    margin: 0 auto;
  }

  .content article h2 {
    margin-top: 34px;
    font-size: 24px;
  }

  .callout,
  .decision-box {
    margin: 22px 0;
    padding: 16px;
    border: 1px solid var(--line);
    border-left: 4px solid var(--red);
    border-radius: 0 6px 6px 0;
    background: #fffdf8;
  }

  .feature-band,
  .split,
  .database-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(260px, 1fr);
    gap: clamp(20px, 4vw, 42px);
    align-items: start;
    padding: clamp(20px, 4vw, 34px) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .feature-list { display: grid; gap: 9px; }
  .feature-list.compact a { min-height: 0; }
  .split p { color: var(--muted); font-size: 15px; }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
  }

  .section-heading h2,
  .section-heading p { margin: 0; }

  .section-heading p {
    max-width: 480px;
    color: var(--muted);
    font-size: 14px;
  }

  .database-panel {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #181412;
    color: #fffdf8;
    box-shadow: none;
  }

  .database-panel p { color: rgba(255, 253, 248, 0.72); }
  .database-panel .eyebrow { color: #f0d7a2; }

  .database-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid rgba(255, 253, 248, 0.16);
    border-radius: 6px;
    overflow: hidden;
    background: rgba(255, 253, 248, 0.16);
  }

  .database-metrics a,
  .database-metrics span {
    min-height: 84px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 13px;
    background: rgba(255, 253, 248, 0.08);
    text-decoration: none;
  }

  .database-metrics strong { font-family: Georgia, "Times New Roman", serif; font-size: 25px; line-height: 1; }
  .database-metrics small { color: rgba(255, 253, 248, 0.72); font-size: 12px; }

  .trust-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }

  .trust-strip span,
  .trust-strip a {
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fffdf8;
    text-decoration: none;
  }

  .decision-box h2,
  .decision-box h3 { margin-top: 0; }

  .table-wrap {
    margin: 18px 0;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fff;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 620px;
    font-size: 14px;
  }

  th,
  td {
    padding: 11px 13px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  th { color: var(--ink); background: #f5efe4; }
  tr:last-child td { border-bottom: 0; }

  .faq { margin-top: 34px; padding-top: 10px; border-top: 1px solid var(--line); }
  .faq h2 { margin-top: 0; }
  .faq h3 { margin-top: 20px; }

  .site-footer {
    padding: 24px clamp(18px, 4vw, 44px);
    border-top: 1px solid var(--line);
    color: var(--muted);
    background: #efe7d8;
    font-size: 13px;
  }

  .footer-inner {
    width: min(1180px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(260px, 0.7fr) 1fr;
    gap: 20px;
    align-items: start;
  }

  .site-footer p { margin: 0; max-width: 560px; }

  @media (max-width: 860px) {
    .site-header { grid-template-columns: 1fr; gap: 8px; }
    .primary-nav,
    .site-footer nav { justify-content: flex-start; }
    .grid,
    .feature-band,
    .split,
    .database-panel,
    .pathway,
    .next-links,
    .footer-inner { grid-template-columns: 1fr; }
    .section-heading { align-items: flex-start; flex-direction: column; }
    .database-metrics { grid-template-columns: 1fr; }
  }
</style>
