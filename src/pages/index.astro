---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCard from '../components/GuideCard.astro';

const title = 'Baijiu365 - Baijiu Guides, Tools, Regions, and Database';
const description = 'Baijiu365 is an independent baijiu information and tools site covering aroma types, buying risk, beginner bottles, tasting language, regions, and structured bottle data.';
const keywords = [
  'baijiu guide', 'Chinese baijiu', 'baijiu aroma types',
  'baijiu buying guide', 'Maotai guide', 'Wuliangye', 'Fenjiu',
  'baijiu for beginners', 'Chinese spirits', 'baijiu database'
];
---
<BaseLayout title={title} description={description} keywords={keywords} type="WebSite">
  <section class="news-home">
    <div class="wrap home-grid">
      <article class="lead-story">
        <p class="eyebrow">Field Guide</p>
        <h1>Baijiu, explained by style, region, bottle, and buying risk.</h1>
        <p class="lede">A practical reference site for Chinese baijiu: learn the category, compare benchmark bottles, check risky listings, and use tools before you buy or pour.</p>
        <div class="lead-links">
          <a href="/baijiu-basics/">Start with baijiu basics</a>
          <a href="/types-of-baijiu/">Read the aroma guide</a>
          <a href="/tools/">Open the tools</a>
        </div>
      </article>

      <aside class="home-sidebar" aria-label="Essential baijiu tools">
        <p class="sidebar-title">Tools</p>
        <a href="/tools/first-bottle-recommender/"><strong>First Bottle</strong><span>Choose a sensible starting bottle</span></a>
        <a href="/tools/authenticity-risk-checker/"><strong>Risk Checker</strong><span>Flag high-price buying risks</span></a>
        <a href="/tools/aroma-identifier/"><strong>Aroma Identifier</strong><span>Match tasting notes to style</span></a>
        <a href="/tools/gbt-standard-lookup/"><strong>GB/T Lookup</strong><span>Read standards on labels</span></a>
      </aside>
    </div>
  </section>

  <section class="section home-band">
    <div class="wrap four-up">
      <a href="/baijiu-basics/"><span>Learn</span><strong>Category basics</strong><small>Ingredients, proof, etiquette, and common mistakes.</small></a>
      <a href="/types-of-baijiu/"><span>Aroma</span><strong>Style map</strong><small>Sauce, strong, light, rice, phoenix, herbal, mixed.</small></a>
      <a href="/how-to-buy-baijiu-outside-china/"><span>Buying</span><strong>Risk guide</strong><small>Importer labels, pricing, gift boxes, and refill risk.</small></a>
      <a href="/db/"><span>Database</span><strong>Bottle reference</strong><small>GB/T, ABV, region, raw materials, tasting notes.</small></a>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap content-layout">
      <main class="content-main">
        <div class="section-heading compact-heading">
          <h2>Guides By Question</h2>
          <p>Use these when you have a practical problem, not when you want a brand brochure.</p>
        </div>
        <div class="guide-list">
          <GuideCard href="/best-baijiu-for-beginners/" title="What should I try first?" text="Bottle guidance by occasion, budget, palate, and alcohol tolerance without pretending prestige equals suitability." />
          <GuideCard href="/how-to-drink-baijiu/" title="How should I serve it?" text="Small pours, food pairing, pacing, glassware, banquet etiquette, and ways to avoid turning baijiu into a dare." />
          <GuideCard href="/how-to-spot-fake-maotai/" title="Is this expensive bottle risky?" text="Counterfeit, refill, vintage, development-product, and price signals to check before spending." />
          <GuideCard href="/baijiu-flavor-wheel/" title="How do I describe the flavor?" text="A tasting vocabulary for grain, fruit, floral, savory, fermented, heat, texture, and finish." />
          <GuideCard href="/baijiu-vs-vodka/" title="Why is it not vodka?" text="Fermentation character, distillation strength, aroma compounds, serving context, and category intent." />
        </div>
      </main>

      <aside class="content-side">
        <section class="side-block">
          <h2>Database Benchmarks</h2>
          <a href="/db/variety/maotai/"><span>Maotai</span><small>Sauce aroma / Guizhou / GB/T 18356</small></a>
          <a href="/db/variety/wuliangye/"><span>Wuliangye</span><small>Five-grain strong aroma benchmark</small></a>
          <a href="/db/variety/fenjiu/"><span>Fenjiu</span><small>Clean light-aroma entry point</small></a>
          <a href="/db/compare/"><span>Compare profiles</span><small>Put 2 or 3 bottles side by side</small></a>
        </section>

        <section class="side-block muted-block">
          <h2>Editorial Position</h2>
          <p>Baijiu365 treats baijiu as a regional spirit category, not a prestige leaderboard. The useful questions are style, source, serving context, risk, and whether the bottle fits the drinker.</p>
          <a href="/editorial-policy/">Editorial policy</a>
        </section>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .news-home {
    padding: 30px clamp(18px, 4vw, 44px) 22px;
    border-bottom: 1px solid var(--line);
    background: #fffdf8;
  }

  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.36fr);
    gap: 28px;
    align-items: stretch;
  }

  .lead-story {
    min-height: 310px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background:
      linear-gradient(90deg, rgba(255, 253, 248, 0.98), rgba(255, 253, 248, 0.82)),
      url('/images/baijiu-field-guide.png') right center / contain no-repeat;
  }

  .lead-story h1 {
    max-width: 680px;
    font-size: clamp(30px, 4.2vw, 46px);
  }

  .lead-story .lede {
    max-width: 620px;
  }

  .lead-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .lead-links a {
    padding: 7px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    color: var(--red);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }

  .home-sidebar {
    display: grid;
    align-content: start;
    border-top: 3px solid var(--ink);
  }

  .sidebar-title {
    margin: 0;
    padding: 12px 0 8px;
    color: var(--red);
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .home-sidebar a {
    display: block;
    padding: 13px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  .home-sidebar strong {
    display: block;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 17px;
    line-height: 1.15;
  }

  .home-sidebar span {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 13px;
  }

  .home-band {
    padding-top: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
    background: #f4ead9;
  }

  .four-up {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--line);
  }

  .four-up a {
    min-height: 118px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px;
    background: #fffdf8;
    text-decoration: none;
  }

  .four-up span {
    color: var(--red);
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .four-up strong {
    display: block;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 18px;
    line-height: 1.12;
  }

  .four-up small {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.45;
  }

  .content-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.34fr);
    gap: 28px;
    align-items: start;
  }

  .compact-heading h2 {
    font-size: clamp(22px, 2.4vw, 30px);
  }

  .guide-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .content-side {
    display: grid;
    gap: 16px;
  }

  .side-block {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fffdf8;
  }

  .side-block h2 {
    font-size: 21px;
  }

  .side-block a {
    display: block;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  .side-block span {
    display: block;
    color: var(--ink);
    font-weight: 900;
  }

  .side-block small,
  .side-block p {
    color: var(--muted);
    font-size: 13px;
  }

  .muted-block {
    background: #f6efe4;
  }

  .muted-block a {
    color: var(--red);
    font-weight: 900;
  }

  @media (max-width: 900px) {
    .home-grid,
    .content-layout,
    .four-up,
    .guide-list { grid-template-columns: 1fr; }
    .lead-story { min-height: auto; background: #fffdf8; }
  }
</style>
