---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'fs';
import path from 'path';

const title = 'Baijiu365 — Baijiu Guides, Tools, Regions, and Database';
const description = 'Baijiu365 is an independent baijiu information and tools site covering aroma types, buying risk, beginner bottles, tasting language, regions, and structured bottle data.';
const keywords = [
  'baijiu guide', 'Chinese baijiu', 'baijiu aroma types',
  'baijiu buying guide', 'Maotai guide', 'Wuliangye', 'Fenjiu',
  'baijiu for beginners', 'Chinese spirits', 'baijiu database'
];

const varietiesDir = path.resolve(process.cwd(), 'data_pipeline/varieties');
const allVarieties = fs.readdirSync(varietiesDir)
  .filter(f => f.endsWith('.json'))
  .map(f => JSON.parse(fs.readFileSync(path.join(varietiesDir, f), 'utf-8')));
const featuredIds = ['maotai', 'wuliangye', 'fenjiu'];
const featured = featuredIds.map(id => allVarieties.find(v => v.id === id)).filter(Boolean);

const aromas = [
  {
    key: 'sauce', name: 'Sauce Aroma', cn: '酱香', img: '/images/aroma-sauce.webp',
    text: 'Savory, umami-driven, the most intense style. Multiple fermentation cycles over a full year.',
  },
  {
    key: 'strong', name: 'Strong Aroma', cn: '浓香', img: '/images/aroma-strong.webp',
    text: 'Fruity, cellar-influenced, the most widely consumed style in China. Aged mud pits.',
  },
  {
    key: 'light', name: 'Light Aroma', cn: '清香', img: '/images/aroma-light.webp',
    text: 'Clean, grain-forward, the easiest entry point. Ceramic jar fermentation.',
  },
  {
    key: 'phoenix', name: 'Phoenix Aroma', cn: '凤香', img: '/images/aroma-phoenix.webp',
    text: 'Unique to Shaanxi. A hybrid style with a distinctive sweet-sour finish.',
  },
  {
    key: 'herbal', name: 'Herbal Aroma', cn: '董香', img: '/images/aroma-herbal.webp',
    text: 'Medicinal herbs in production. Rare and acquired, with Dongjiu as the benchmark.',
  },
  {
    key: 'mixed', name: 'Mixed Aroma', cn: '兼香', img: '/images/aroma-mixed.webp',
    text: 'Layered complexity from combined fermentation techniques, led by Jiugui.',
  },
];

const guides = [
  {
    href: '/baijiu-basics/', kicker: 'Start here', title: 'Baijiu Basics',
    text: 'What baijiu is, why it is not vodka, how aroma types work, and why one bad banquet glass should not define the category.',
    img: '/images/hero-bottle.webp', alt: 'White porcelain baijiu bottle beside a tasting cup',
  },
  {
    href: '/best-baijiu-for-beginners/', kicker: 'First bottle', title: 'Choose Your First Bottle',
    text: 'Pick a bottle by occasion, aroma type, alcohol strength, and budget instead of prestige alone.',
    img: '/images/variety-fenjiu.webp', alt: 'Light-aroma style baijiu bottle',
  },
  {
    href: '/how-to-drink-baijiu/', kicker: 'Serving', title: 'How To Drink It',
    text: 'Small pours, food pairing, pacing, glassware, banquet etiquette, and ways to avoid turning baijiu into a dare.',
    img: '/images/craft-tasting.webp', alt: 'Small porcelain baijiu tasting cups on a dark table',
  },
  {
    href: '/how-to-buy-baijiu-outside-china/', kicker: 'Buying', title: 'Buying Outside China',
    text: 'What to check before buying abroad: importer labels, price signals, gift boxes, and marketplace listings.',
    img: '/images/og-cover.webp', alt: 'Baijiu bottle and cup in warm light',
  },
  {
    href: '/how-to-spot-fake-maotai/', kicker: 'Risk', title: 'Spot Fake Maotai',
    text: 'A risk-first guide to counterfeits, refilled bottles, development products, vintage claims, and price signals.',
    img: '/images/variety-maotai.webp', alt: 'Sauce-aroma style baijiu bottle with red ribbon',
  },
  {
    href: '/baijiu-flavor-wheel/', kicker: 'Tasting', title: 'Name The Flavor',
    text: 'A tasting vocabulary for grain, fruit, floral, savory, fermented notes, heat, texture, and finish.',
    img: '/images/aroma-strong.webp', alt: 'Golden baijiu glass with layered amber tones',
  },
];

const tools = [
  { href: '/tools/first-bottle-recommender/', name: 'First Bottle', text: 'Choose a sensible starting bottle', num: 'I' },
  { href: '/tools/authenticity-risk-checker/', name: 'Risk Checker', text: 'Flag high-price buying risks', num: 'II' },
  { href: '/tools/aroma-identifier/', name: 'Aroma Identifier', text: 'Match tasting notes to style', num: 'III' },
  { href: '/tools/gbt-standard-lookup/', name: 'GB/T Lookup', text: 'Read standards on labels', num: 'IV' },
];
---

<BaseLayout title={title} description={description} keywords={keywords} type="WebSite">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <video
        data-autoplay
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/images/hero-pour.webp"
      >
        <source src="/video/hero-pour.mp4" type="video/mp4" />
        <img src="/images/hero-pour.webp" alt="" />
      </video>
    </div>
    <div class="hero-content">
      <p class="eyebrow">The English-language field guide</p>
      <h1 class="hero-title">Baijiu, explained by <em>style</em>, region, bottle, and <span class="cn">醇</span> risk.</h1>
      <p class="lede">A practical reference for Chinese baijiu: learn the category, compare benchmark bottles, check risky listings, and use the tools before you buy or pour.</p>
      <div class="actions">
        <a class="button" href="/baijiu-basics/">Start with baijiu basics</a>
        <a class="button secondary" href="/db/">Explore the database</a>
      </div>
      <div class="hero-stats">
        <div><strong>{allVarieties.length}</strong><span>Benchmark varieties</span></div>
        <div><strong>6</strong><span>Aroma types</span></div>
        <div><strong>8</strong><span>Producing regions</span></div>
        <div><strong>GB/T</strong><span>Standard codes</span></div>
      </div>
    </div>
  </section>

  <!-- Aroma types -->
  <section class="section">
    <div class="wrap">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">Six aroma types</p>
          <h2>Read baijiu by style, not by bottle shape.</h2>
        </div>
        <p>Sauce, strong, light, phoenix, herbal, and mixed. Aroma type predicts flavor, intensity, difficulty, and the right bottle for the occasion.</p>
      </div>
      <div class="aroma-grid">
        {aromas.map(a => (
          <a class="aroma-card reveal" href={`/db/aroma/${a.key}/`}>
            <img src={a.img} alt={`${a.name} baijiu`} loading="lazy" width="900" height="900" />
            <div class="aroma-card-body">
              <p class="kicker">{a.cn} &middot; {a.name.split(' ')[0]}</p>
              <h3>{a.name}</h3>
              <p>{a.text}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Craft / cellar -->
  <section class="section" style="background:linear-gradient(180deg,var(--ink-950),var(--ink-900));">
    <div class="wrap">
      <div class="craft-split">
        <div class="craft-media reveal">
          <video data-autoplay autoplay muted loop playsinline preload="metadata" poster="/images/craft-aging.webp">
            <source src="/video/craft-cellar.mp4" type="video/mp4" />
            <img src="/images/craft-aging.webp" alt="Traditional baijiu aging cellar with clay jars" />
          </video>
        </div>
        <div class="reveal">
          <p class="eyebrow">From grain to glass</p>
          <h2>Fermentation is the whole story.</h2>
          <p class="lede">Baijiu is not distilled vodka. Grain, qu starter, pits, jars, and time create the aroma compounds before the still ever runs. This is why the same base spirit can taste like tropical fruit, roasted grain, or fermented bean paste.</p>
          <ul class="process-steps">
            <li>
              <span class="step-num">1</span>
              <div><strong>Qu starter</strong><p>Grain is seeded with a solid fermentation starter that supplies the microbes shaping aroma.</p></div>
            </li>
            <li>
              <span class="step-num">2</span>
              <div><strong>Pit or jar fermentation</strong><p>Mud pits, stone cellars, or ceramic jars decide which microbes thrive and which aromas dominate.</p></div>
            </li>
            <li>
              <span class="step-num">3</span>
              <div><strong>Solid-state distillation</strong><p>Steamed grain is distilled in solid form, concentrating flavor rather than stripping it away.</p></div>
            </li>
            <li>
              <span class="step-num">4</span>
              <div><strong>Aging and blending</strong><p>Clay jars and years of rest soften heat and round the finish before bottling.</p></div>
            </li>
          </ul>
          <div class="actions">
            <a class="button" href="/types-of-baijiu/">Read the aroma guide</a>
            <a class="button secondary" href="/baijiu-vs-vodka/">Baijiu vs vodka</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Guides -->
  <section class="section">
    <div class="wrap">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">Guides by question</p>
          <h2>Practical answers, not a brand brochure.</h2>
        </div>
        <p>Use these when you have a practical problem: choosing, serving, buying, tasting, or verifying a bottle.</p>
      </div>
      <div class="guide-grid">
        {guides.map(g => (
          <a class="guide-card-media reveal" href={g.href}>
            <div class="thumb"><img src={g.img} alt={g.alt} loading="lazy" width="900" height="563" /></div>
            <div class="body">
              <p class="kicker">{g.kicker}</p>
              <h3>{g.title}</h3>
              <p>{g.text}</p>
              <span class="more">Read guide <span aria-hidden="true">&rarr;</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Database benchmarks -->
  <section class="section" style="background:linear-gradient(180deg,var(--ink-900),var(--ink-950));">
    <div class="wrap">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">Baijiu parameter database</p>
          <h2>Compare baijiu by hard data, not marketing.</h2>
        </div>
        <p>{allVarieties.length} varieties across 6 aroma types and 8 producing regions. Every entry includes verified GB/T standard codes, ABV ranges, raw ingredient lists, tasting notes, and price-tiered buying guidance.</p>
      </div>
      <div class="variety-grid">
        {featured.map(v => (
          <a class="variety-card reveal" href={`/db/variety/${v.id}/`}>
            <div class="bottle"><img src={`/images/variety-${v.id}.webp`} alt={`${v.name} style bottle`} loading="lazy" width="700" height="875" /></div>
            <div class="body">
              <h3>{v.name} <span class="cn">{v.name_cn}</span></h3>
              <p class="meta">{v.abv_range} &middot; {v.gbt_standard} &middot; {v.region}</p>
            </div>
          </a>
        ))}
        <a class="variety-card reveal" href="/db/">
          <div class="bottle" style="display:flex;align-items:center;justify-content:center;">
            <div style="text-align:center;padding:24px;">
              <span style="font-family:var(--serif);font-size:44px;color:var(--gold-300);">{allVarieties.length}</span>
              <p style="margin:6px 0 0;color:var(--muted-on-dark);font-size:13.5px;">varieties in the database</p>
              <span class="more" style="margin-top:14px;">Browse all <span aria-hidden="true">&rarr;</span></span>
            </div>
          </div>
          <div class="body">
            <h3>Full Database</h3>
            <p class="meta">Aroma &middot; Region &middot; Compare</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Quote band -->
  <section class="quote-band">
    <div class="bg" aria-hidden="true"><img src="/images/region-river.webp" alt="" loading="lazy" width="1600" height="1024" /></div>
    <div class="wrap">
      <blockquote class="reveal">
        <span class="cn">酒是陈的香</span> &mdash; the liquor improves with age, and the region writes the recipe before the cellar does.
      </blockquote>
      <cite>Baijiu365 field guide</cite>
    </div>
  </section>

  <!-- Tools + CTA -->
  <section class="section tight">
    <div class="wrap">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">Decision tools</p>
          <h2>Use the site by decision.</h2>
        </div>
        <p>Four small tools for the four questions that come up before a first pour or an overseas order.</p>
      </div>
      <div class="tools-strip">
        {tools.map(t => (
          <a class="tool-tile reveal" href={t.href}>
            <span class="num">{t.num}</span>
            <strong>{t.name}</strong>
            <span>{t.text}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <p class="eyebrow reveal">Independent guide</p>
      <h2 class="reveal">Style first. Bottle second. Risk always.</h2>
      <p class="reveal">Baijiu365 treats baijiu as a regional spirit category, not a prestige leaderboard. No paid placements, practical limits stated.</p>
      <div class="actions reveal">
        <a class="button" href="/db/">Open the database</a>
        <a class="button secondary" href="/editorial-policy/">Editorial policy</a>
      </div>
    </div>
  </section>
</BaseLayout>
