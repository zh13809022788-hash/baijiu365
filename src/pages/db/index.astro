---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'fs';
import path from 'path';

const varietiesDir = path.resolve(process.cwd(), 'data_pipeline/varieties');
const files = fs.readdirSync(varietiesDir).filter(f => f.endsWith('.json'));
const varieties = files.map(f => JSON.parse(fs.readFileSync(path.join(varietiesDir, f), 'utf-8')));
const sortedVarieties = [...varieties].sort((a, b) => a.name.localeCompare(b.name));

const aromaGroups = {};
for (const v of varieties) {
  if (!aromaGroups[v.aroma_type]) aromaGroups[v.aroma_type] = [];
  aromaGroups[v.aroma_type].push(v);
}

const regionGroups = {};
for (const v of varieties) {
  if (!regionGroups[v.region]) regionGroups[v.region] = [];
  regionGroups[v.region].push(v);
}

const aromaLabels = {
  sauce: 'Sauce Aroma', strong: 'Strong Aroma', light: 'Light Aroma',
  phoenix: 'Phoenix Aroma', herbal: 'Herbal Aroma', mixed: 'Mixed Aroma',
  rice: 'Rice Aroma', sesame: 'Sesame Aroma', fuyu: 'Fuyu Aroma',
  te: 'Te Aroma', chi: 'Chi Aroma', la: 'La Aroma',
};

const aromaCn = {
  sauce: '酱香', strong: '浓香', light: '清香', phoenix: '凤香', herbal: '董香', mixed: '兼香',
  rice: '米香', sesame: '芝麻香', fuyu: '馥郁香', te: '特香', chi: '豉香', la: '老白干',
};

const tierLabels = {
  'ultra-premium': 'Ultra Premium',
  premium: 'Premium',
  mid: 'Mid-Range',
  budget: 'Budget',
};

const featuredIds = ['maotai', 'wuliangye', 'fenjiu'];
const featured = featuredIds.map(id => varieties.find(v => v.id === id)).filter(Boolean);
const title = `Baijiu Database - ${varieties.length} Varieties Across ${Object.keys(aromaGroups).length} Aroma Types | Baijiu365`;
const description = `Complete baijiu parameter database: ${varieties.length} varieties, ${Object.keys(aromaGroups).length} aroma types, ${Object.keys(regionGroups).length} producing regions. Every entry includes GB/T standards, ABV, ingredients, tasting notes, and buying guides.`;
const keywords = ['baijiu database', 'baijiu varieties', 'baijiu parameters', 'GB/T baijiu standards', 'baijiu comparison'];
---

<BaseLayout title={title} description={description} keywords={keywords} type="WebSite">
  <section class="db-hero">
    <div class="db-hero-bg" aria-hidden="true"><img src="/images/hero-bottle.webp" alt="" width="1600" height="1024" /></div>
    <div class="wrap db-hero-grid">
      <div>
        <p class="eyebrow"><a href="/">Baijiu365</a> &rsaquo; Database</p>
        <h1>Baijiu Database</h1>
        <p class="lede">A structured reference for comparing Chinese baijiu by aroma type, region, GB/T standard, ABV, ingredients, price tier, and practical drinking context. Hard data, no tasting-room poetry.</p>
        <div class="actions">
          <a class="button" href="/db/compare/">Compare varieties</a>
          <a class="button secondary" href="/db/variety/maotai/">Open Maotai profile</a>
        </div>
      </div>
      <div class="db-metrics" aria-label="Database coverage">
        <span><strong>{varieties.length}</strong>Varieties</span>
        <span><strong>{Object.keys(aromaGroups).length}</strong>Aroma types</span>
        <span><strong>{Object.keys(regionGroups).length}</strong>Regions</span>
        <span><strong>GB/T</strong>Standards</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">Start with a benchmark</p>
          <h2>Three profiles anchor the category.</h2>
        </div>
        <p>Prestige sauce aroma, multi-grain strong aroma, and the clean light-aroma gateway. Open a profile or send them into the comparison tool.</p>
      </div>
      <div class="variety-grid">
        {featured.map(v => (
          <a class="variety-card reveal" href={`/db/variety/${v.id}/`}>
            <div class="bottle"><img src={`/images/variety-${v.id}.webp`} alt={`${v.name} style bottle`} loading="lazy" width="700" height="875" /></div>
            <div class="body">
              <h3>{v.name} <span class="cn">{v.name_cn}</span></h3>
              <p class="meta">{aromaLabels[v.aroma_type] || v.aroma_type} &middot; {v.abv_range} &middot; {v.gbt_standard}</p>
              <p class="meta">{v.region} &middot; {tierLabels[v.tier] || v.tier}</p>
            </div>
          </a>
        ))}
      </div>
      <p class="db-figure-note">Bottle images are illustrative renders of each style, not photographs of the specific product. Specifications come from producer labels and national standards.</p>
    </div>
  </section>

  <section class="section" style="background:linear-gradient(180deg,var(--ink-950),var(--ink-900));">
    <div class="wrap db-browser">
      <div class="browser-panel">
        <div class="section-heading reveal">
          <div>
            <p class="eyebrow">Browse by aroma</p>
            <h2>Aroma predicts the bottle.</h2>
          </div>
          <p>Use aroma type to predict intensity, texture, and whether a bottle is likely to feel clean, fruity, savory, or botanical.</p>
        </div>
        <div class="aroma-grid">
          {Object.entries(aromaGroups).map(([type, items]) => (
            <a class="aroma-card reveal" href={`/db/aroma/${type}/`}>
              <img src={`/images/aroma-${type}.webp`} alt={`${aromaLabels[type] || type} baijiu`} loading="lazy" width="900" height="900" />
              <div class="aroma-card-body">
                <p class="kicker">{aromaCn[type] || ''} &middot; {items.length} varieties</p>
                <h3>{aromaLabels[type] || type}</h3>
                <p>{items.map(v => v.name).join(' / ')}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <aside class="region-panel reveal" aria-label="Browse by producing region">
        <p class="eyebrow">Producing regions</p>
        <div class="region-list">
          {Object.entries(regionGroups).sort(([a], [b]) => a.localeCompare(b)).map(([region, items]) => (
            <a href={`/db/region/${region.toLowerCase()}/`}>
              <span>{region}</span>
              <small>{items.length} {items.length === 1 ? 'variety' : 'varieties'}</small>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">All varieties</p>
          <h2>Scan the full database.</h2>
        </div>
        <p>Open a profile or send several bottles into the comparison tool.</p>
      </div>
      <div class="table-wrap reveal">
        <table class="database-table">
          <thead>
            <tr>
              <th>Variety</th>
              <th>Aroma</th>
              <th>ABV</th>
              <th>GB/T Standard</th>
              <th>Region</th>
              <th>Tier</th>
            </tr>
          </thead>
          <tbody>
            {sortedVarieties.map(v => (
              <tr>
                <td><a class="variety-link" href={`/db/variety/${v.id}/`}>{v.name}</a></td>
                <td><a href={`/db/aroma/${v.aroma_type}/`}>{aromaLabels[v.aroma_type] || v.aroma_type}</a></td>
                <td>{v.abv_range}</td>
                <td><code>{v.gbt_standard}</code></td>
                <td><a href={`/db/region/${v.region.toLowerCase()}/`}>{v.region}</a></td>
                <td><span class={`tier-pill tier-${v.tier}`}>{tierLabels[v.tier] || v.tier}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .db-figure-note {
    margin: 18px 0 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--muted-on-dark);
    max-width: 78ch;
  }
  .db-hero {
    position: relative;
    padding: clamp(130px, 17vh, 190px) 0 clamp(44px, 5vw, 68px);
    overflow: hidden;
    background: var(--ink-950);
  }
  .db-hero-bg { position: absolute; inset: 0; }
  .db-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 70% 60%; opacity: 0.55; }
  .db-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(13, 10, 7, 0.94) 20%, rgba(13, 10, 7, 0.55) 70%, rgba(13, 10, 7, 0.75)),
      linear-gradient(180deg, rgba(13, 10, 7, 0.5), rgba(13, 10, 7, 0.2) 50%, rgba(13, 10, 7, 0.9));
  }
  .db-hero .wrap { position: relative; z-index: 1; }

  .db-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.5fr);
    gap: clamp(28px, 6vw, 72px);
    align-items: end;
  }
  .db-hero h1 { max-width: 760px; }

  .db-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--line-dark);
    border-radius: 10px;
    overflow: hidden;
    background: var(--line-dark);
  }
  .db-metrics span {
    min-height: 96px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 18px;
    background: rgba(13, 10, 7, 0.82);
    color: var(--muted-on-dark);
    font-size: 13px;
  }
  .db-metrics strong {
    color: var(--gold-300);
    font-family: var(--serif);
    font-size: 30px;
    line-height: 1;
  }

  .db-browser {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.34fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }

  .region-panel {
    padding: 26px;
    border: 1px solid var(--line-dark);
    border-radius: 12px;
    background: linear-gradient(170deg, rgba(211, 172, 104, 0.07), rgba(211, 172, 104, 0.02));
    position: sticky;
    top: 96px;
  }
  .region-list { display: grid; gap: 2px; margin-top: 16px; }
  .region-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid transparent;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-on-dark);
    font-size: 14.5px;
    font-weight: 600;
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .region-list a:hover { background: rgba(211, 172, 104, 0.1); border-color: var(--line-dark); }
  .region-list small { color: var(--muted-on-dark); font-size: 12.5px; font-weight: 500; }

  .database-table code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    color: var(--gold-300);
  }
  .variety-link { font-weight: 700; }
  .database-table td code { white-space: nowrap; }

  .tier-pill {
    display: inline-block;
    padding: 3px 10px;
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted-on-dark);
    white-space: nowrap;
  }
  .tier-ultra-premium { border-color: rgba(211, 172, 104, 0.55); color: var(--gold-300); }
  .tier-premium { border-color: rgba(211, 172, 104, 0.35); color: var(--gold-400); }

  @media (max-width: 1024px) {
    .db-browser { grid-template-columns: 1fr; }
    .region-panel { position: static; }
  }
  @media (max-width: 860px) {
    .db-hero-grid { grid-template-columns: 1fr; }
    .db-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .db-metrics { grid-template-columns: 1fr; }
  }
</style>
