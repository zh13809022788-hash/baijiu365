    margin-bottom: 10px;
    font-size: clamp(22px, 3vw, 32px);
  }

  .empty-state p:last-child {
    max-width: 640px;
    margin: 0 auto;
    color: var(--muted);
  }

  .compare-output {
    overflow: hidden;
  }

  .compare-output-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(20px, 4vw, 30px);
    border-bottom: 1px solid var(--line-dark);
    background: rgba(13, 10, 7, 0.42);
  }

  .compare-output-head .eyebrow {
    color: var(--gold-400);
  }

  .compare-output-head h2 {
    margin: 0;
    font-size: clamp(24px, 4vw, 40px);
  }

  .compare-table-wrap {
    overflow-x: auto;
  }

  .compare-table {
    width: 100%;
    min-width: 920px;
    border-collapse: collapse;
    font-size: 14px;
  }

  .compare-table th,
  .compare-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .compare-table th {
    text-align: left;
    background: rgba(255, 253, 247, 0.03);
  }

  .compare-table .parameter-head,
  .compare-table .row-label {
    width: 170px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .compare-table .var-name {
    display: block;
    color: var(--text-on-dark);
    font-family: var(--serif);
    font-size: 21px;
    line-height: 1.1;
    text-decoration: none;
  }

  .compare-table .var-name:hover {
    color: var(--gold-300);
  }

  .compare-table .var-meta {
    display: block;
    margin-top: 6px;
    color: var(--muted);
    font-size: 13px;
  }

  .tier-badge {
    display: inline-flex;
    margin-top: 10px;
    padding: 4px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .tier-high { background: rgba(211, 172, 104, 0.18); color: var(--gold-300); }
  .tier-mid { background: rgba(159, 192, 207, 0.16); color: #9fc0cf; }
  .tier-budget { background: rgba(143, 179, 126, 0.16); color: #a8c79a; }

  .compare-table .section-head td {
    padding: 11px 16px;
    background: rgba(211, 172, 104, 0.09);
    color: var(--gold-400);
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .compare-table td a {
    color: var(--gold-400);
    font-weight: 800;
    text-decoration: none;
  }

  .compare-table code {
    padding: 4px 7px;
    border-radius: 5px;
    background: #f7f1e7;
    color: var(--ink);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  }

  .taste-note,
  .product-list {
    display: block;
    max-width: 460px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.55;
  }

  .yes,
  .no {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    padding: 4px 9px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 900;
  }

  .yes { background: rgba(143, 179, 126, 0.16); color: #a8c79a; }
  .no { background: rgba(176, 58, 42, 0.18); color: #e08c7c; }

  /* ---------- editorial guide below the tool ---------- */
  .compare-guide { border-top: 1px solid var(--line-dark); }
  .compare-guide-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(280px, 0.85fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .guide-prose h2 {
    margin: 0 0 16px;
    font-family: var(--serif);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 500;
  }
  .guide-prose h3 {
    margin: 30px 0 10px;
    font-family: var(--serif);
    font-size: 21px;
    font-weight: 500;
    color: var(--gold-300);
  }
  .guide-prose p {
    margin: 0 0 16px;
    font-size: 16px;
    line-height: 1.75;
    color: rgba(242, 236, 221, 0.8);
  }
  .guide-prose ul { margin: 0 0 18px; padding-left: 20px; }
  .guide-prose li {
    margin-bottom: 10px;
    font-size: 15.5px;
    line-height: 1.7;
    color: rgba(242, 236, 221, 0.78);
  }
  .guide-prose strong { color: var(--text-on-dark); }
  .guide-prose a { color: var(--gold-300); }

  .guide-aside {
    position: sticky;
    top: 96px;
    padding: 22px 22px 18px;
    border: 1px solid var(--line-dark);
    border-radius: 12px;
    background: linear-gradient(170deg, rgba(255, 253, 247, 0.045), rgba(255, 253, 247, 0.012));
  }
  .guide-aside h2 {
    margin: 0 0 14px;
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-300);
  }
  .preset {
    display: block;
    padding: 13px 0;
    text-decoration: none;
    border-bottom: 1px dotted rgba(211, 172, 104, 0.2);
  }
  .preset:last-child { border-bottom: 0; padding-bottom: 0; }
  .preset strong {
    display: block;
    font-family: var(--serif);
    font-size: 16.5px;
    font-weight: 500;
    color: var(--text-on-dark);
    margin-bottom: 3px;
  }
  .preset span { display: block; font-size: 13px; line-height: 1.55; color: var(--muted-on-dark); }
  .preset:hover strong { color: var(--gold-300); }

  @media (max-width: 900px) {
    .compare-guide-grid { grid-template-columns: 1fr; }
