---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'fs';
import path from 'path';

const varietiesDir = path.resolve(process.cwd(), 'data_pipeline/varieties');
const files = fs.readdirSync(varietiesDir).filter(f => f.endsWith('.json'));
const allVarieties = files.map(f => JSON.parse(fs.readFileSync(path.join(varietiesDir, f), 'utf-8')));
const sortedVarieties = [...allVarieties].sort((a, b) => a.name.localeCompare(b.name));

const aromaLabels = {
  sauce: 'Sauce Aroma', strong: 'Strong Aroma', light: 'Light Aroma',
  phoenix: 'Phoenix Aroma', herbal: 'Herbal Aroma', mixed: 'Mixed Aroma',
};

const tierLabels = {
  'ultra-premium': 'Ultra Premium',
  premium: 'Premium',
  mid: 'Mid-Range',
  budget: 'Budget',
};

const title = 'Compare Baijiu Varieties Side by Side | Baijiu365';
const description = 'Compare any 2-3 Chinese baijiu varieties side by side: aroma type, GB/T standard, ABV, region, price, raw materials, production method, tasting notes, and food pairings.';
const keywords = [
  'compare baijiu', 'baijiu comparison', 'Maotai vs Wuliangye',
  'baijiu side by side', 'baijiu difference', 'which baijiu to buy',
  'sauce vs strong aroma', 'baijiu varieties compared',
];
---

<BaseLayout title={title} description={description} keywords={keywords} type="WebSite">
  <section class="compare-hero">
    <div class="wrap compare-hero-grid">
      <div>
        <p class="eyebrow"><a href="/db/">Database</a> &rsaquo; Compare</p>
        <h1>Compare Baijiu Varieties</h1>
        <p class="lede">Select 2 or 3 bottles to compare standards, aroma type, ABV, region, raw materials, tasting notes, food pairings, and buying signals side by side.</p>
      </div>
      <div class="tool-summary" aria-label="Comparison tool coverage">
        <span><strong>2-3</strong> varieties per view</span>
        <span><strong>12+</strong> comparison rows</span>
        <span><strong>URL</strong> shareable hash</span>
      </div>
    </div>
  </section>

  <section class="section compare-section">
    <div class="wrap">
      <div class="compare-tool">
        <div class="picker-panel" id="picker-bar">
          <div class="picker-heading">
            <p class="eyebrow">Build A Comparison</p>
            <h2>Select bottles</h2>
          </div>
          <div class="picker-grid">
            <div class="picker-slot">
              <label for="pick1">Variety 1</label>
              <select id="pick1" onchange="updateComparison()">
                <option value="">Select a variety</option>
                {sortedVarieties.map(v => <option value={v.id}>{v.name}</option>)}
              </select>
            </div>
            <div class="picker-slot">
              <label for="pick2">Variety 2</label>
              <select id="pick2" onchange="updateComparison()">
                <option value="">Select a variety</option>
                {sortedVarieties.map(v => <option value={v.id}>{v.name}</option>)}
              </select>
            </div>
            <div class="picker-slot">
              <label for="pick3">Variety 3 <span class="opt">optional</span></label>
              <select id="pick3" onchange="updateComparison()">
                <option value="">None</option>
                {sortedVarieties.map(v => <option value={v.id}>{v.name}</option>)}
              </select>
            </div>
          </div>
          <div class="quick-compares" aria-label="Popular comparisons">
            <span>Popular:</span>
            <button type="button" onclick="quickCompare('maotai','wuliangye')">Maotai vs Wuliangye</button>
            <button type="button" onclick="quickCompare('luzhou-laojiao','jiannanchun')">Luzhou Laojiao vs Jiannanchun</button>
            <button type="button" onclick="quickCompare('fenjiu','hongxing','niulanshan')">Fenjiu vs Hongxing vs Niulanshan</button>
          </div>
        </div>

        <div id="comparison-result" class="comparison-empty">
          <div class="empty-state">
            <p class="eyebrow">Waiting for selection</p>
            <h2>Select 2 or 3 varieties above to compare.</h2>
            <p>Use this when choosing a first bottle, explaining a banquet pour, checking whether a listing matches the right style, or building a tasting flight.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ varietyData: Object.fromEntries(allVarieties.map(v => [v.id, v])), aromaLabels, tierLabels }}>
  function updateComparison() {
    const ids = [document.getElementById('pick1').value, document.getElementById('pick2').value, document.getElementById('pick3').value].filter(Boolean);
    if (ids.length < 2) {
      document.getElementById('comparison-result').innerHTML = `<div class="empty-state">
        <p class="eyebrow">Waiting for selection</p>
        <h2>Select 2 or 3 varieties above to compare.</h2>
        <p>Use this when choosing a first bottle, explaining a banquet pour, checking whether a listing matches the right style, or building a tasting flight.</p>
      </div>`;
      document.getElementById('comparison-result').classList.add('comparison-empty');
      return;
    }

    const vars = ids.map(id => varietyData[id]).filter(Boolean);
    if (vars.length < 2) return;
    renderComparison(vars);
  }

  function quickCompare(...ids) {
    document.getElementById('pick1').value = ids[0] || '';
    document.getElementById('pick2').value = ids[1] || '';
    document.getElementById('pick3').value = ids[2] || '';
    updateComparison();
  }

  function row(label, values) {
    return `<tr><td class="row-label">${label}</td>${values.map(v => `<td>${v}</td>`).join('')}</tr>`;
  }

  function renderComparison(vars) {
    const n = vars.length;
    const headers = vars.map(v => {
      const tierClass = v.tier === 'ultra-premium' || v.tier === 'premium' ? 'tier-high' : v.tier === 'budget' ? 'tier-budget' : 'tier-mid';
      return `<th><a href="/db/variety/${v.id}/" class="var-name">${v.name}</a><span class="var-meta">${aromaLabels[v.aroma_type] || v.aroma_type} / ${v.region}</span><span class="tier-badge ${tierClass}">${tierLabels[v.tier] || v.tier}</span></th>`;
    }).join('');

    const priceStr = v => v.price_range_usd ? `$${v.price_range_usd.min} &ndash; $${v.price_range_usd.max}` : '&mdash;';
    const materialsStr = v => v.production?.raw_materials?.join(', ') || '&mdash;';
    const noseStr = v => v.tasting_notes?.nose || '&mdash;';
    const palateStr = v => v.tasting_notes?.palate || '&mdash;';
    const finishStr = v => v.tasting_notes?.finish || '&mdash;';

    const pairingsStr = v => {
      if (!v.food_pairings?.length) return '&mdash;';
      return v.food_pairings.map(p => `<strong>${p.cuisine}:</strong> ${p.dishes.join(', ')}`).join('<br>');
    };

    const comparablesStr = v => {
      if (!v.comparable_spirits?.length) return '&mdash;';
      return v.comparable_spirits.map(c => `${c.spirit} - ${c.reason}`).join('<br>');
    };

    const beginnerStr = v => v.beginner_friendly
      ? '<span class="yes">Yes</span>'
      : '<span class="no">No</span>';

    const coreProductsStr = v => {
      if (!v.core_products?.length) return '&mdash;';
      return v.core_products.slice(0, 4).map(p =>
        `${p.name}: ${p.abv}, ${p.volume_ml}ml${p.msrp_cny ? ', &yen;' + p.msrp_cny : ''}${p.is_flagship ? ' flagship' : ''}`
      ).join('<br>');
    };

    const html = `
      <div class="compare-output">
        <div class="compare-output-head">
          <div>
            <p class="eyebrow">Comparison Ready</p>
            <h2>${vars.map(v => v.name).join(' vs ')}</h2>
          </div>
          <a href="/db/" class="back-link">Browse database</a>
        </div>
        <div class="compare-table-wrap">
          <table class="compare-table cols-${n}">
            <thead><tr><th class="parameter-head">Parameter</th>${headers}</tr></thead>
            <tbody>
              <tr class="section-head"><td colspan="${n + 1}">Basic Parameters</td></tr>
              ${row('Brand', vars.map(v => v.brand?.name || '&mdash;'))}
              ${row('Aroma Type', vars.map(v => `<a href="/db/aroma/${v.aroma_type}/">${aromaLabels[v.aroma_type] || v.aroma_type}</a>`))}
              ${row('GB/T Standard', vars.map(v => `<code>${v.gbt_standard}</code>`))}
              ${row('Region', vars.map(v => `<a href="/db/region/${v.region.toLowerCase()}/">${v.region}</a>`))}
              ${row('ABV Range', vars.map(v => v.abv_range))}
              ${row('Price (USD)', vars.map(v => priceStr(v)))}
              ${row('Beginner Friendly', vars.map(v => beginnerStr(v)))}

              <tr class="section-head"><td colspan="${n + 1}">Production Method</td></tr>
              ${row('Raw Materials', vars.map(v => materialsStr(v)))}
              ${row('Qu Type', vars.map(v => v.production?.qu_type || '&mdash;'))}
              ${row('Fermentation', vars.map(v => v.production?.fermentation || '&mdash;'))}
              ${row('Distillation', vars.map(v => v.production?.distillation || '&mdash;'))}

              <tr class="section-head"><td colspan="${n + 1}">Tasting</td></tr>
              ${row('Nose', vars.map(v => `<span class="taste-note">${noseStr(v)}</span>`))}
              ${row('Palate', vars.map(v => `<span class="taste-note">${palateStr(v)}</span>`))}
              ${row('Finish', vars.map(v => `<span class="taste-note">${finishStr(v)}</span>`))}

              <tr class="section-head"><td colspan="${n + 1}">Bottle And Food Context</td></tr>
              ${row('Core Products', vars.map(v => `<span class="product-list">${coreProductsStr(v)}</span>`))}
              ${row('Best With', vars.map(v => pairingsStr(v)))}
              ${row('Comparable Spirits', vars.map(v => comparablesStr(v)))}
            </tbody>
          </table>
        </div>
      </div>
    `;

    const hashIds = vars.map(v => v.id).join(',');
    if (history.replaceState) history.replaceState(null, '', `#${hashIds}`);

    const target = document.getElementById('comparison-result');
    target.innerHTML = html;
    target.classList.remove('comparison-empty');
  }

  document.addEventListener('DOMContentLoaded', () => {
    const hash = window.location.hash.replace('#', '');
    if (hash) {
      const ids = hash.split(',');
      if (ids.length >= 2) {
        document.getElementById('pick1').value = ids[0] || '';
        document.getElementById('pick2').value = ids[1] || '';
        document.getElementById('pick3').value = ids[2] || '';
        updateComparison();
      }
    }
  });
</script>

<style>
  .compare-hero {
    padding: clamp(34px, 5vw, 58px) clamp(18px, 4vw, 44px) clamp(24px, 4vw, 36px);
    border-bottom: 1px solid var(--line);
    background: #181412;
    color: #fffdf8;
  }

  .compare-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.36fr);
    gap: clamp(24px, 6vw, 64px);
    align-items: end;
  }

  .compare-hero h1 {
    max-width: 820px;
    font-size: clamp(32px, 4.8vw, 54px);
  }

  .compare-hero .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .tool-summary {
    display: grid;
    gap: 1px;
    border: 1px solid rgba(255, 253, 248, 0.16);
    border-radius: 8px;
    overflow: hidden;
    background: rgba(255, 253, 248, 0.16);
  }

  .tool-summary span {
    min-height: 70px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px;
    background: rgba(255, 253, 248, 0.08);
    color: rgba(255, 253, 248, 0.72);
    font-size: 13px;
  }

  .tool-summary strong {
    color: #fffdf8;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 24px;
    line-height: 1;
  }

  .compare-section {
    padding-top: 34px;
  }

  .compare-tool {
    display: grid;
    gap: 20px;
  }

  .picker-panel,
  .empty-state,
  .compare-output {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 2px 0 rgba(32, 29, 26, 0.03);
  }

  .picker-panel {
    padding: clamp(20px, 4vw, 30px);
  }

  .picker-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }

  .picker-heading .eyebrow {
    color: var(--red);
  }

  .picker-heading h2 {
    margin: 0;
    font-size: clamp(28px, 4vw, 42px);
  }

  .picker-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .picker-slot label {
    display: block;
    margin-bottom: 7px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .picker-slot .opt {
    color: var(--soft);
    font-weight: 700;
    text-transform: none;
  }

  .picker-slot select {
    width: 100%;
    min-height: 46px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fffaf1;
    color: var(--ink);
    font: inherit;
  }

  .quick-compares {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-top: 18px;
  }

  .quick-compares span {
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
  }

  .quick-compares button,
  .back-link {
    min-height: 34px;
    padding: 7px 11px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fff;
    color: var(--red);
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }

  .quick-compares button:hover,
  .back-link:hover {
    border-color: rgba(159, 47, 36, 0.46);
    background: #fff7ef;
  }

  .empty-state {
    padding: clamp(26px, 5vw, 44px) 18px;
    text-align: center;
  }

  .empty-state .eyebrow {
    color: var(--red);
  }

  .empty-state h2 {
    margin-bottom: 10px;
    font-size: clamp(22px, 3vw, 32px);
  }

  .empty-state p:last-child {
    max-width: 640px;
    margin: 0 auto;
    color: var(--muted);
  }

  .compare-output {
    overflow: hidden;
  }

  .compare-output-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(20px, 4vw, 30px);
    border-bottom: 1px solid var(--line);
    background: #fffaf1;
  }

  .compare-output-head .eyebrow {
    color: var(--red);
  }

  .compare-output-head h2 {
    margin: 0;
    font-size: clamp(24px, 4vw, 40px);
  }

  .compare-table-wrap {
    overflow-x: auto;
  }

  .compare-table {
    width: 100%;
    min-width: 920px;
    border-collapse: collapse;
    font-size: 14px;
  }

  .compare-table th,
  .compare-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .compare-table th {
    text-align: left;
    background: #fff;
  }

  .compare-table .parameter-head,
  .compare-table .row-label {
    width: 170px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .compare-table .var-name {
    display: block;
    color: var(--ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 20px;
    line-height: 1.1;
    text-decoration: none;
  }

  .compare-table .var-name:hover {
    color: var(--red);
  }

  .compare-table .var-meta {
    display: block;
    margin-top: 6px;
    color: var(--muted);
    font-size: 13px;
  }

  .tier-badge {
    display: inline-flex;
    margin-top: 10px;
    padding: 4px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .tier-high { background: #fff1c8; color: #7a4d0b; }
  .tier-mid { background: #e9f1f4; color: #244d5f; }
  .tier-budget { background: #e8f4df; color: #34572d; }

  .compare-table .section-head td {
    padding: 11px 16px;
    background: #f4ead9;
    color: var(--red);
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .compare-table td a {
    color: var(--red);
    font-weight: 800;
    text-decoration: none;
  }

  .compare-table code {
    padding: 4px 7px;
    border-radius: 5px;
    background: #f7f1e7;
    color: var(--ink);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  }

  .taste-note,
  .product-list {
    display: block;
    max-width: 460px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.55;
  }

  .yes,
  .no {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    padding: 4px 9px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 900;
  }

  .yes { background: #e8f4df; color: #34572d; }
  .no { background: #f8e7e3; color: #84251d; }

  @media (max-width: 860px) {
    .compare-hero-grid,
    .picker-grid { grid-template-columns: 1fr; }
    .compare-output-head,
    .picker-heading { align-items: flex-start; flex-direction: column; }
    .tool-summary { grid-template-columns: 1fr; }
  }
</style>