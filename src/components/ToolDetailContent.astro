---
import { common, getToolPath, languages, toolContent, type Lang, type ToolSlug } from '../data/toolContent';
import { toolMethod, toolNotes } from '../data/toolDetail';

interface Props { lang: Lang; slug: ToolSlug }
const { lang, slug } = Astro.props;
const tool = toolContent[slug][lang];
const c = common[lang];
const method = toolMethod[lang];
const notes = toolNotes[slug][lang];
const widgetText = {
  bestFor: 'Best for', related: 'Related reading', run: 'Get guidance', fullCompare: 'Open the full comparison table',
  budget: 'Budget', scenario: 'Scenario', tolerance: 'Alcohol tolerance', channel: 'Buying channel', price: 'Price signal', packaging: 'Packaging claim', age: 'Age claim',
  descriptors: 'Select tasting signals', standard: 'Choose style', result: 'Result', howItWorks: 'What this result means',
};
---

<section class="tool-hero">
  <div class="wrap tool-hero-grid">
    <div>
      <p class="eyebrow"><a href={getToolPath(lang)}>{c.tools}</a> &rsaquo; {tool.eyebrow}</p>
      <h1>{tool.h1}</h1>
      <p class="lede">{tool.lede}</p>
    </div>
    <div class="language-panel" aria-label="Tool languages">
      {Object.entries(languages).map(([code, item]) => (
        <a class={code === lang ? 'active' : ''} href={`${item.prefix}/tools/${slug}/`}>{item.label}</a>
      ))}
    </div>
  </div>
</section>

<section class="section tool-body">
  <div class="wrap tool-layout">
    <div class="tool-main">
      <article class="tool-widget" data-tool={slug}>
        {slug === 'first-bottle-recommender' && (
          <form class="tool-form" data-widget="first-bottle">
            <label>{widgetText.budget}<select name="budget"><option value="low">Under $30</option><option value="mid">$30-100</option><option value="high">$100+</option></select></label>
            <label>{widgetText.scenario}<select name="scenario"><option value="learn">Learning</option><option value="dinner">Dinner</option><option value="gift">Gift</option></select></label>
            <label>{widgetText.tolerance}<select name="tolerance"><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option></select></label>
            <button type="submit">{widgetText.run}</button>
          </form>
        )}

        {slug === 'authenticity-risk-checker' && (
          <form class="tool-form" data-widget="risk">
            <label>{widgetText.channel}<select name="channel"><option value="official">Official or trusted importer</option><option value="marketplace">Marketplace seller</option><option value="private">Private seller</option></select></label>
            <label>{widgetText.price}<select name="price"><option value="normal">Normal market range</option><option value="cheap">Much cheaper than market</option><option value="unknown">Cannot verify market price</option></select></label>
            <label>{widgetText.packaging}<select name="packaging"><option value="plain">Normal current packaging</option><option value="gift">Luxury gift box emphasis</option><option value="odd">Odd label or unclear edition</option></select></label>
            <label>{widgetText.age}<select name="age"><option value="none">No age claim</option><option value="clear">Clear vintage or batch documentation</option><option value="vague">Vague old bottle claim</option></select></label>
            <button type="submit">{widgetText.run}</button>
          </form>
        )}

        {slug === 'aroma-identifier' && (
          <form class="tool-form checkbox-form" data-widget="aroma">
            <fieldset>
              <legend>{widgetText.descriptors}</legend>
              <label><input type="checkbox" name="note" value="sauce" /> Soy, roasted grain, savory, fermented</label>
              <label><input type="checkbox" name="note" value="strong" /> Ripe fruit, pit aroma, rich sweetness</label>
              <label><input type="checkbox" name="note" value="light" /> Clean grain, pear, floral, crisp</label>
              <label><input type="checkbox" name="note" value="herbal" /> Herbs, medicine, botanical spice</label>
              <label><input type="checkbox" name="note" value="rice" /> Rice, light sweetness, soft finish</label>
            </fieldset>
            <button type="submit">{widgetText.run}</button>
          </form>
        )}

        {slug === 'baijiu-compare' && (
          <div class="compare-launch">
            <p>{tool.description}</p>
            <a class="btn-primary" href="/db/compare/#maotai,wuliangye">Maotai vs Wuliangye</a>
            <a class="btn-outline" href="/db/compare/#fenjiu,hongxing,niulanshan">Fenjiu vs Hongxing vs Niulanshan</a>
            <a class="btn-outline" href="/db/compare/">{widgetText.fullCompare}</a>
          </div>
        )}

        {slug === 'gbt-standard-lookup' && (
          <form class="tool-form" data-widget="gbt">
            <label>{widgetText.standard}<select name="style"><option value="sauce">Sauce aroma</option><option value="strong">Strong aroma</option><option value="light">Light aroma</option><option value="rice">Rice aroma</option><option value="phoenix">Phoenix aroma</option><option value="mixed">Mixed aroma</option></select></label>
            <button type="submit">{widgetText.run}</button>
          </form>
        )}

        <div class="tool-result" aria-live="polite">
          <p class="result-kicker">{widgetText.result}</p>
          <h2>{c.result}</h2>
          <p>{c.note}</p>
        </div>
      </article>

      <section class="tool-notes">
        <h2>{widgetText.howItWorks}</h2>
        {notes.map(n => (
          <div class="note-block">
            <h3>{n.h}</h3>
            <p>{n.p}</p>
          </div>
        ))}
      </section>
    </div>

    <aside class="tool-sidebar">
      <section>
        <h2>{widgetText.bestFor}</h2>
        <ul>{tool.bestFor.map(item => <li>{item}</li>)}</ul>
      </section>
      <section>
        <h2>{widgetText.related}</h2>
        <div class="related-list">
          {tool.related.map(item => <a href={item.href}>{item.label}</a>)}
        </div>
      </section>
    </aside>
  </div>
</section>

<section class="section tight">
  <div class="wrap">
    <section class="tool-method">
      <h2>{method.title}</h2>
      <div class="method-grid">
        {method.items.map(m => (
          <div class="method-card">
            <h3>{m.h}</h3>
            <p>{m.p}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</section>

<script define:vars={{ lang }}>
  const result = document.querySelector('.tool-result');
  const copy = {
    first: {
      low: 'Start with Fenjiu or another clean light-aroma bottle. Keep the first pour small and drink with food.',
      mid: 'Look at Fenjiu, Yanghe, Gujinggong, or a moderate strong-aroma bottle before jumping to prestige labels.',
      high: 'If this is a gift, choose a recognized benchmark. If it is for learning, spend less and taste across styles.'
    },
    risk: ['Low visible risk, but still verify importer, seal, batch, and seller return policy.', 'Moderate risk. Ask for more documentation before buying.', 'High risk. Avoid unless provenance is unusually strong.'],
    aroma: {
      sauce: 'Most consistent with sauce aroma: savory, roasted, fermented, complex.',
      strong: 'Most consistent with strong aroma: fruit-rich, rounded, and pit-fermented.',
      light: 'Most consistent with light aroma: clean, grain-forward, floral, crisp.',
      herbal: 'Most consistent with herbal aroma: botanical, medicinal, spiced.',
      rice: 'Most consistent with rice aroma: soft, rice-sweet, lighter body.'
    },
    gbt: {
      sauce: 'GB/T 26760 is commonly associated with sauce-aroma baijiu. Maotai also uses GB/T 18356 as a geographic indication standard.',
      strong: 'GB/T 10781.1 is the common strong-aroma baijiu standard.',
      light: 'GB/T 10781.2 is the common light-aroma baijiu standard.',
      rice: 'GB/T 10781.3 is the common rice-aroma baijiu standard.',
      phoenix: 'GB/T 14867 is associated with phoenix-aroma baijiu.',
      mixed: 'Mixed aroma can involve GB/T 23547 or producer-specific standards; inspect the exact label.'
    }
  };

  function setResult(title, text) {
    if (!result) return;
    result.innerHTML = `<p class="result-kicker">${title}</p><h2>${title}</h2><p>${text}</p>`;
  }

  document.querySelectorAll('.tool-form').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);

      if (form.dataset.widget === 'first-bottle') {
        const budget = data.get('budget');
        setResult('Recommendation', copy.first[budget] || copy.first.mid);
      }

      if (form.dataset.widget === 'risk') {
        let score = 0;
        if (data.get('channel') === 'marketplace') score += 1;
        if (data.get('channel') === 'private') score += 2;
        if (data.get('price') === 'cheap') score += 2;
        if (data.get('price') === 'unknown') score += 1;
        if (data.get('packaging') === 'gift') score += 1;
        if (data.get('packaging') === 'odd') score += 2;
        if (data.get('age') === 'vague') score += 2;
        const index = score >= 5 ? 2 : score >= 2 ? 1 : 0;
        setResult(['Low risk', 'Moderate risk', 'High risk'][index], copy.risk[index]);
      }

      if (form.dataset.widget === 'aroma') {
        const notes = data.getAll('note');
        const winner = notes[0] || 'light';
        setResult('Likely direction', copy.aroma[winner]);
      }

      if (form.dataset.widget === 'gbt') {
        const style = data.get('style') || 'sauce';
        setResult('GB/T reference', copy.gbt[style]);
      }
    });
  });
</script>

<style>
  /* ---------- hero ---------- */
  .tool-hero {
    position: relative;
    padding: clamp(122px, 16vh, 170px) 0 clamp(38px, 5vw, 56px);
    border-bottom: 1px solid var(--line-dark);
    background:
      radial-gradient(120% 90% at 78% 0%, rgba(211, 172, 104, 0.14), transparent 62%),
      linear-gradient(180deg, var(--ink-950), var(--ink-900));
  }
  .tool-hero-grid, .tool-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.3fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }
  .tool-hero h1 { max-width: 880px; }
  .tool-hero .lede { max-width: 58ch; }
  .tool-hero .eyebrow a { color: var(--gold-400); text-decoration: none; }
  .tool-hero .eyebrow a:hover { color: var(--gold-300); }

  .language-panel { display: grid; gap: 7px; }
  .language-panel a {
    min-height: 40px;
    display: flex;
    align-items: center;
    padding: 9px 13px;
    border: 1px solid var(--line-dark-strong);
    border-radius: 8px;
    font-size: 13px;
    letter-spacing: 0.03em;
    color: var(--muted-on-dark);
    text-decoration: none;
    background: rgba(255, 253, 247, 0.02);
  }
  .language-panel a.active,
  .language-panel a:hover {
    background: rgba(211, 172, 104, 0.14);
    border-color: var(--gold-500);
    color: var(--gold-300);
  }

  /* ---------- layout ---------- */
  .tool-main { display: grid; gap: 26px; min-width: 0; }

  .tool-widget, .tool-sidebar section, .tool-notes, .tool-method {
    border: 1px solid var(--line-dark);
    border-radius: 12px;
    background: linear-gradient(170deg, rgba(255, 253, 247, 0.045), rgba(255, 253, 247, 0.012));
  }
  .tool-widget { overflow: hidden; }

  .tool-form, .compare-launch {
    display: grid;
    gap: 16px;
    padding: clamp(20px, 3vw, 28px);
    border-bottom: 1px solid var(--line-dark);
  }
  .tool-form label, .tool-form fieldset {
    display: grid;
    gap: 8px;
    margin: 0;
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-300);
  }
  .tool-form select {
    min-height: 44px;
    padding: 11px 13px;
    border: 1px solid var(--line-dark-strong);
    border-radius: 8px;
    background: rgba(13, 10, 7, 0.62);
    color: var(--text-on-dark);
    font: inherit;
    font-size: 14.5px;
    letter-spacing: 0;
    text-transform: none;
  }
  .tool-form select:focus-visible,
  .tool-form button:focus-visible {
    outline: 2px solid var(--gold-400);
    outline-offset: 2px;
  }

  .tool-form button, .btn-primary, .btn-outline {
    width: fit-content;
    min-height: 44px;
    padding: 12px 22px;
    border-radius: 999px;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  .tool-form button, .btn-primary {
    border: 1px solid var(--gold-400);
    background: var(--gold-400);
    color: #140e08;
  }
  .tool-form button:hover, .btn-primary:hover { background: var(--gold-300); border-color: var(--gold-300); }
  .btn-outline {
    border: 1px solid var(--line-dark-strong);
    background: transparent;
    color: var(--gold-300);
  }
  .btn-outline:hover { border-color: var(--gold-400); background: rgba(211, 172, 104, 0.1); }

  .compare-launch p { margin: 0; color: var(--muted-on-dark); font-size: 15px; }

  .checkbox-form fieldset { border: 0; padding: 0; }
  .checkbox-form label {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    min-height: 42px;
    padding: 10px 13px;
    border: 1px solid var(--line-dark);
    border-radius: 8px;
    background: rgba(13, 10, 7, 0.4);
    color: var(--text-on-dark);
    font-size: 14.5px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    cursor: pointer;
  }
  .checkbox-form label:hover { border-color: var(--line-dark-strong); }
  .checkbox-form input { accent-color: var(--gold-500); width: 16px; height: 16px; }

  .tool-result {
    padding: clamp(20px, 3vw, 28px);
    background: rgba(13, 10, 7, 0.42);
  }
  .result-kicker {
    margin: 0 0 8px;
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-400);
  }
  .tool-result h2 { margin: 0 0 8px; font-family: var(--serif); font-size: clamp(21px, 2.6vw, 27px); font-weight: 500; }
  .tool-result p:last-child { margin: 0; color: var(--muted-on-dark); font-size: 15px; line-height: 1.65; }

  /* ---------- notes ---------- */
  .tool-notes { padding: clamp(20px, 3vw, 30px); }
  .tool-notes > h2, .tool-method > h2 {
    margin: 0 0 18px;
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-300);
  }
  .note-block { padding-top: 16px; border-top: 1px solid var(--line-dark); margin-top: 16px; }
  .note-block:first-of-type { padding-top: 0; border-top: 0; margin-top: 0; }
  .note-block h3 {
    margin: 0 0 7px;
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 500;
    color: var(--text-on-dark);
  }
  .note-block p { margin: 0; font-size: 15.5px; line-height: 1.7; color: rgba(242, 236, 221, 0.8); }

  .tool-method { padding: clamp(20px, 3vw, 30px); }
  .method-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .method-card {
    padding: 16px 16px 14px;
    border: 1px solid var(--line-dark);
    border-radius: 9px;
    background: rgba(13, 10, 7, 0.32);
  }
  .method-card h3 {
    margin: 0 0 7px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--gold-300);
  }
  .method-card p { margin: 0; font-size: 13.5px; line-height: 1.62; color: rgba(242, 236, 221, 0.74); }

  /* ---------- sidebar ---------- */
  .tool-sidebar { display: grid; gap: 14px; position: sticky; top: 96px; align-content: start; }
  .tool-sidebar section { padding: 20px; }
  .tool-sidebar h2 {
    margin: 0 0 12px;
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-300);
  }
  .tool-sidebar ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .tool-sidebar li {
    position: relative;
    padding-left: 16px;
    font-size: 14px;
    color: rgba(242, 236, 221, 0.82);
  }
  .tool-sidebar li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold-500);
  }
  .related-list { display: grid; gap: 0; }
  .related-list a {
    padding: 9px 0;
    font-size: 14px;
    color: rgba(242, 236, 221, 0.82);
    text-decoration: none;
    border-bottom: 1px dotted rgba(211, 172, 104, 0.18);
  }
  .related-list a:last-child { border-bottom: 0; }
  .related-list a:hover { color: var(--gold-300); }

  @media (max-width: 1024px) {
    .tool-hero-grid, .tool-layout { grid-template-columns: 1fr; }
    .tool-sidebar { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .method-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .tool-sidebar { grid-template-columns: 1fr; }
    .language-panel { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
