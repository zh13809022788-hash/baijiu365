---
import { common, getToolPath, languages, toolContent, toolSlugs, toolsHome, type Lang } from '../data/toolContent';

interface Props { lang: Lang }
const { lang } = Astro.props;
const home = toolsHome[lang];
const c = common[lang];
---
<section class="tools-hero">
  <div class="wrap tools-hero-grid">
    <div>
      <p class="eyebrow">{home.eyebrow}</p>
      <h1>{home.h1}</h1>
      <p class="lede">{home.lede}</p>
    </div>
    <div class="language-panel" aria-label="Tool languages">
      {Object.entries(languages).map(([code, item]) => (
        <a class={code === lang ? 'active' : ''} href={`${item.prefix}/tools/`}>{item.label}</a>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-heading">
      <h2>{home.introTitle}</h2>
      <p>{home.introText}</p>
    </div>
    <div class="tools-grid">
      {toolSlugs.map((slug) => {
        const tool = toolContent[slug][lang];
        return (
          <a class="tool-card" href={getToolPath(lang, slug)}>
            <span>{tool.eyebrow}</span>
            <h3>{tool.shortTitle}</h3>
            <p>{tool.description}</p>
            <strong>{home.openTool}</strong>
          </a>
        );
      })}
    </div>
  </div>
</section>

<section class="section tight">
  <div class="wrap tool-note-band">
    <p>{c.note}</p>
  </div>
</section>

<style>
  .tools-hero {
    padding: clamp(34px, 5vw, 56px) clamp(18px, 4vw, 44px) clamp(24px, 4vw, 38px);
    border-bottom: 1px solid var(--line);
    background: #181412;
    color: #fffdf8;
  }

  .tools-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.28fr);
    gap: clamp(20px, 4vw, 42px);
    align-items: end;
  }

  .tools-hero h1 {
    max-width: 920px;
    font-size: clamp(32px, 4.8vw, 54px);
  }

  .language-panel {
    display: grid;
    gap: 8px;
  }

  .language-panel a {
    min-height: 42px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 12px;
    border: 1px solid rgba(255, 253, 248, 0.2);
    border-radius: 6px;
    color: rgba(255, 253, 248, 0.78);
    text-decoration: none;
  }

  .language-panel a.active,
  .language-panel a:hover {
    background: #fffdf8;
    color: var(--ink);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 18px;
  }

  .tool-card {
    min-height: 178px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    box-shadow: 0 2px 0 rgba(32, 29, 26, 0.03);
  }

  .tool-card:hover {
    border-color: rgba(159, 47, 36, 0.46);
    box-shadow: var(--shadow);
  }

  .tool-card span {
    color: var(--red);
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .tool-card p {
    color: var(--muted);
  }

  .tool-card strong {
    color: var(--red);
  }

  .tool-note-band {
    padding: 18px 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .tools-hero-grid,
    .tools-grid { grid-template-columns: 1fr; }
  }
</style>
<style is:global>
  @media (max-width: 1100px) { .tools-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .tools-grid { grid-template-columns: 1fr; } }
</style>
